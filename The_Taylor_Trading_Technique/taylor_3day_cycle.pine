//@version=6
indicator("Taylor 3-Day Cycle", overlay=true,
     max_labels_count=500)

// ═══════════════════════════════════════════════════════════
// Taylor's 3-Day Cycle anchored to REAL swing lows.
//
// The method: markets swing in ~3 day up-legs from swing
// lows. Day 1 from a swing low = Buy Day (accumulation).
// Day 2 = Sell Day (distribute longs). Day 3 = Short Sale
// Day (short the exhaustion). Then a 1-2 day decline back
// to the next swing low restarts the count.
//
// This version detects actual swing lows using a
// short-term ZigZag, counts days from each swing low,
// and marks the Taylor day types accordingly.
// ═══════════════════════════════════════════════════════════

// ─── INPUTS ───────────────────────────────────────────────
swingPct = input.float(1.5, "Swing Threshold %",
     minval=0.3, maxval=10.0, step=0.1,
     tooltip="Minimum % move to confirm a swing " +
     "reversal. Smaller = more swings detected. " +
     "Try 1.0-2.0 for stocks, 0.5-1.0 for futures.")
showBg     = input.bool(true, "Background Colors")
showLabels = input.bool(true, "Day Labels")
showSignals = input.bool(true, "Trade Signals")
showLevels = input.bool(true, "Objective Levels")
buyColor   = input.color(#00C853, "Buy Day")
sellColor  = input.color(#FFD600, "Sell Day")
shortColor = input.color(#FF1744, "Short Sale Day")
declineColor = input.color(#9E9E9E, "Decline Day")

// ═══════════════════════════════════════════════════════════
// ZIGZAG SWING DETECTION
// ═══════════════════════════════════════════════════════════
// Track alternating swing highs and lows.
// A swing low is confirmed when price rallies swingPct%
// off a low. A swing high is confirmed when price drops
// swingPct% off a high.

var int dir = 0           // 1 = trending up, -1 = down
var float swLow  = low    // current/last swing low price
var float swHigh = high   // current/last swing high price
var int swLowBar  = 0     // bar_index of swing low
var int swHighBar = 0     // bar_index of swing high
var bool newSwingLow  = false
var bool newSwingHigh = false

threshold = swingPct / 100.0
newSwingLow  := false
newSwingHigh := false

if dir != -1
    // trending up or undecided — look for new high
    // or reversal down
    if high > swHigh
        swHigh    := high
        swHighBar := bar_index
    if swHigh > 0 and low <= swHigh * (1 - threshold)
        // confirmed swing high, now declining
        dir := -1
        swLow    := low
        swLowBar := bar_index
        newSwingHigh := true

if dir == -1
    // trending down — look for new low or reversal up
    if low < swLow
        swLow    := low
        swLowBar := bar_index
    if swLow > 0 and high >= swLow * (1 + threshold)
        // confirmed swing low, now rallying
        dir := 1
        swHigh    := high
        swHighBar := bar_index
        newSwingLow := true

// ═══════════════════════════════════════════════════════════
// DAY COUNTING FROM SWING LOW
// ═══════════════════════════════════════════════════════════
// Once a swing low is confirmed, count forward:
//   Day 0 (the swing low bar itself) = Buy Day
//   Day 1 = Sell Day
//   Day 2 = Short Sale Day
//   Day 3+ = Decline / waiting for next swing low
//
// When a new swing low is detected, reset count.

var int dayCount = 0
var int lastSwLowBar = 0
var float lastSwLowPrice = na
var float lastSwHighPrice = na

if newSwingLow
    lastSwLowBar   := swLowBar
    lastSwLowPrice := swLow
    // The swing low bar gets count 0,
    // but we're now past it. Set count so current bar
    // = days since that swing low
    dayCount := bar_index - swLowBar

if newSwingHigh
    lastSwHighPrice := swHigh

// Increment each bar (reset handled by newSwingLow)
if not newSwingLow
    dayCount += 1
else
    dayCount := bar_index - lastSwLowBar

// Classify the day
// 0 = Buy Day, 1 = Sell Day, 2 = Short Sale Day,
// 3+ = Decline (waiting for next cycle)
int phase = -1
if dayCount == 0
    phase := 0  // Buy Day
else if dayCount == 1
    phase := 1  // Sell Day
else if dayCount == 2
    phase := 2  // Short Sale Day
else
    phase := 3  // Decline / between cycles

isBuyDay   = phase == 0
isSellDay  = phase == 1
isShortDay = phase == 2
isDecline  = phase == 3

// ═══════════════════════════════════════════════════════════
// SIGNAL MARKS (X vs ✓)
// ═══════════════════════════════════════════════════════════
barRange = high - low
closePos = barRange > 0 ?
     (close - low) / barRange : 0.5

// Buy Day X: low made first → rallied
buyX = close > open and closePos > 0.4
// Sell Day X: high made first → sold off
sellX = close < open and closePos < 0.6
// SS Day X: high made first → declined
shortX = close < open and closePos < 0.6

// ═══════════════════════════════════════════════════════════
// STORED PRICES PER CYCLE
// ═══════════════════════════════════════════════════════════
var float cycBuyLow   = na
var float cycBuyHigh  = na
var float cycSellHigh = na
var float cycSellLow  = na
var float cycSSHigh   = na
var float prevSSHigh  = na
var float prevSSLow   = na

// Reset on new cycle
if isBuyDay
    prevSSHigh  := cycSSHigh
    prevSSLow   := na(cycSSHigh) ? na : cycSellLow
    cycBuyLow   := low
    cycBuyHigh  := high
    cycSellHigh := na
    cycSellLow  := na
    cycSSHigh   := na

if isSellDay
    cycSellHigh := high
    cycSellLow  := low

if isShortDay
    cycSSHigh := high

// ═══════════════════════════════════════════════════════════
// TAYLOR'S BOOK COLUMNS
// ═══════════════════════════════════════════════════════════
// D: previous SS high → this Buy low (decline)
float dCol = na
if isBuyDay and not na(prevSSHigh)
    dCol := prevSSHigh - low

// R: Buy low → Sell high (rally)
float rCol = na
if isSellDay and not na(cycBuyLow)
    rCol := high - cycBuyLow

// T-L: Buy low → SS high (full 3-day swing)
float tlCol = na
if isShortDay and not na(cycBuyLow)
    tlCol := high - cycBuyLow

// BV: Sell Day low < Buy Day low (violation)
float bvCol = na
if isSellDay and not na(cycBuyLow) and
     low < cycBuyLow
    bvCol := cycBuyLow - low

// ═══════════════════════════════════════════════════════════
// PENETRATIONS
// ═══════════════════════════════════════════════════════════
sellPen = isSellDay and not na(cycBuyHigh) and
     high > cycBuyHigh

shortPen = isShortDay and not na(cycSellHigh) and
     high > cycSellHigh

// ═══════════════════════════════════════════════════════════
// TRADE SIGNALS
// ═══════════════════════════════════════════════════════════
// BUY: Buy Day + low made FIRST (X) — the swing low
buySignal = isBuyDay and buyX

// SELL: Sell Day + penetrated Buy Day high +
//   high made FIRST
sellSignal = isSellDay and sellPen and sellX

// SHORT: SS Day + penetrated Sell Day high +
//   high made FIRST
shortSignal = isShortDay and shortPen and shortX

// VIOLATION BUY: Sell Day dipped below Buy Day low
//   but recovered (close back above it)
violationBuy = isSellDay and not na(cycBuyLow) and
     low < cycBuyLow and close > cycBuyLow and
     closePos > 0.4

// ═══════════════════════════════════════════════════════════
// VISUALS
// ═══════════════════════════════════════════════════════════

// ─── Background ──────────────────────────────────────────
color bgCol = isBuyDay ? color.new(buyColor, 90) :
     isSellDay ? color.new(sellColor, 90) :
     isShortDay ? color.new(shortColor, 90) :
     color.new(declineColor, 95)
bgcolor(showBg ? bgCol : na)

// ─── Day Labels ──────────────────────────────────────────
if showLabels and barstate.isconfirmed and phase <= 2
    string txt = ""
    color lc = color.gray

    if isBuyDay
        string mark = buyX ? " ✕" : " ✓"
        txt := "BUY" + mark
        if not na(dCol)
            txt += "\nD:" +
                 str.tostring(dCol, "#.#")
        lc := buyColor

    else if isSellDay
        string mark = sellX ? " ✕" : " ✓"
        txt := "SELL" + mark
        if not na(rCol)
            txt += "\nR:" +
                 str.tostring(rCol, "#.#")
        if sellPen
            txt += " ▲"
        if not na(bvCol) and bvCol > 0
            txt += "\nBV:" +
                 str.tostring(bvCol, "#.#")
        lc := sellColor

    else if isShortDay
        string mark = shortX ? " ✕" : " ✓"
        txt := "SS" + mark
        if not na(tlCol)
            txt += "\nT:" +
                 str.tostring(tlCol, "#.#")
        if shortPen
            txt += " ▼"
        lc := shortColor

    label.new(bar_index, low, txt,
         style=label.style_label_up,
         color=color.new(lc, 80),
         textcolor=lc,
         size=size.tiny)

// ─── Objective Levels ────────────────────────────────────
// Show the key price level Taylor watches for each day
float objLevel = na
if showLevels
    if isSellDay and not na(cycBuyHigh)
        objLevel := cycBuyHigh  // sell at/above this
    else if isShortDay and not na(cycSellHigh)
        objLevel := cycSellHigh // short at/above this

plot(objLevel, "Objective",
     color=color.new(color.white, 50),
     style=plot.style_circles,
     linewidth=2)

// ─── Trade Signal Shapes ─────────────────────────────────
plotshape(showSignals and buySignal and
     barstate.isconfirmed,
     title="Buy",
     location=location.belowbar,
     style=shape.triangleup,
     color=buyColor,
     size=size.small)

plotshape(showSignals and sellSignal and
     barstate.isconfirmed,
     title="Sell",
     location=location.abovebar,
     style=shape.diamond,
     color=sellColor,
     size=size.small)

plotshape(showSignals and shortSignal and
     barstate.isconfirmed,
     title="Short",
     location=location.abovebar,
     style=shape.triangledown,
     color=shortColor,
     size=size.small)

plotshape(showSignals and violationBuy and
     barstate.isconfirmed,
     title="Violation Buy",
     location=location.belowbar,
     style=shape.cross,
     color=color.new(#2196F3, 0),
     size=size.small)

// ─── Data Window ─────────────────────────────────────────
plot(dCol, "D Column",
     display=display.data_window, color=shortColor)
plot(rCol, "R Column",
     display=display.data_window, color=buyColor)
plot(bvCol, "BV Column",
     display=display.data_window, color=color.purple)
plot(tlCol, "T-L Column",
     display=display.data_window, color=sellColor)
plot(phase * 1.0, "Phase (0=B 1=S 2=SS 3=Dec)",
     display=display.data_window, color=color.gray)
plot(dayCount * 1.0, "Days from Swing Low",
     display=display.data_window, color=color.white)
