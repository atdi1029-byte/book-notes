//@version=6
indicator("DSS Forecast — Scalp",
     overlay=false, precision=2)

// Carver forecast framework adapted for scalping.
// Faster DSS pairs (3/2 → 13/8), weighted toward
// speed. HTF remap to 15m or 1H instead of Daily.
// Tighter cooldowns, momentum gate, rapid flips.

// === SETTINGS ===
grpDSS = "DSS Pairs (Scalp-Tuned)"
show1 = input.bool(true,  "DSS 3/2 (fastest)",
     group=grpDSS)
show2 = input.bool(true,  "DSS 5/3",
     group=grpDSS)
show3 = input.bool(true,  "DSS 8/3",
     group=grpDSS)
show4 = input.bool(true,  "DSS 8/5",
     group=grpDSS)
show5 = input.bool(true,  "DSS 13/5",
     group=grpDSS)
show6 = input.bool(true,  "DSS 13/8 (slowest)",
     group=grpDSS)

grpComb = "Combined Forecast"
showCombined = input.bool(true,
     "Show Combined Forecast", group=grpComb)
divMultiplier = input.float(1.31,
     "Diversification Multiplier",
     group=grpComb, minval=1.0, maxval=2.5,
     step=0.01,
     tooltip="Carver default 1.31. Higher = " +
     "more aggressive sizing")

grpWt = "Forecast Weights (must sum to 100)"
w1 = input.float(25, "Weight: DSS 3/2",
     group=grpWt, minval=0, maxval=100)
w2 = input.float(22, "Weight: DSS 5/3",
     group=grpWt, minval=0, maxval=100)
w3 = input.float(18, "Weight: DSS 8/3",
     group=grpWt, minval=0, maxval=100)
w4 = input.float(15, "Weight: DSS 8/5",
     group=grpWt, minval=0, maxval=100)
w5 = input.float(12, "Weight: DSS 13/5",
     group=grpWt, minval=0, maxval=100)
w6 = input.float(8,  "Weight: DSS 13/8",
     group=grpWt, minval=0, maxval=100)

grpHTF = "Higher Timeframe"
showHTF = input.bool(true,
     "Remap to HTF", group=grpHTF)
htfTF = input.timeframe("15", "Timeframe",
     group=grpHTF,
     tooltip="15m or 60 recommended for scalps")
htfSmLen = input.int(4, "HTF EMA Smooth",
     group=grpHTF, minval=1, maxval=12)

grpMom = "Momentum Gate"
useMomGate = input.bool(true,
     "RSI Velocity Filter", group=grpMom,
     tooltip="Require RSI momentum aligned with " +
     "signal direction. Filters choppy flips.")
rsiLen = input.int(9, "RSI Length",
     group=grpMom, minval=2, maxval=21)
rsiVelLen = input.int(3, "Velocity Lookback",
     group=grpMom, minval=1, maxval=8,
     tooltip="Bars to measure RSI change over")
rsiVelThresh = input.float(2.0,
     "Min Velocity",
     group=grpMom, minval=0.5, maxval=10.0,
     step=0.5,
     tooltip="Minimum RSI change over lookback")

grpVis = "Visual"
showIndividual = input.bool(false,
     "Show Individual Forecasts", group=grpVis)

// === DSS BRESSERT FUNCTION ===
dss_bressert(float src, int stochLen,
     int emaLen) =>
    hh = ta.highest(src, stochLen)
    ll = ta.lowest(src, stochLen)
    raw1 = hh != ll ?
         (src - ll) / (hh - ll) * 100 : 50.0
    smooth1 = ta.ema(raw1, emaLen)
    hh2 = ta.highest(smooth1, stochLen)
    ll2 = ta.lowest(smooth1, stochLen)
    raw2 = hh2 != ll2 ?
         (smooth1 - ll2) / (hh2 - ll2) * 100
         : 50.0
    dssLine = ta.ema(raw2, emaLen)
    dssLine

// === DSS FORECAST (0-100 → ±20) ===
dss_fc(int stochLen, int emaLen) =>
    dss = dss_bressert(close, stochLen, emaLen)
    math.max(-20.0, math.min(20.0,
         dss * 0.4 - 20.0))

// === INDIVIDUAL FORECASTS ===
f1_raw = dss_fc(3, 2)
f2_raw = dss_fc(5, 3)
f3_raw = dss_fc(8, 3)
f4_raw = dss_fc(8, 5)
f5_raw = dss_fc(13, 5)
f6_raw = dss_fc(13, 8)

// === COMBINED FORECAST ===
totalWeight = (show1 ? w1 : 0) +
     (show2 ? w2 : 0) +
     (show3 ? w3 : 0) + (show4 ? w4 : 0) +
     (show5 ? w5 : 0) + (show6 ? w6 : 0)

weightedSum = (show1 ? f1_raw * w1 : 0) +
     (show2 ? f2_raw * w2 : 0) +
     (show3 ? f3_raw * w3 : 0) +
     (show4 ? f4_raw * w4 : 0) +
     (show5 ? f5_raw * w5 : 0) +
     (show6 ? f6_raw * w6 : 0)

rawCombined = totalWeight > 0 ?
     weightedSum / totalWeight : 0.0
scaledCombined = rawCombined * divMultiplier
combined = math.max(-20.0,
     math.min(20.0, scaledCombined))

// === HIGHER TIMEFRAME ===
htfRaw = request.security(syminfo.tickerid,
     htfTF, combined)
htfSmoothed = ta.ema(htfRaw, htfSmLen)
displayCombined = showHTF ? htfSmoothed : combined

// === RSI MOMENTUM GATE ===
rsiVal = ta.rsi(close, rsiLen)
rsiVelocity = rsiVal - rsiVal[rsiVelLen]
momBullOk = not useMomGate or
     rsiVelocity > rsiVelThresh
momBearOk = not useMomGate or
     rsiVelocity < -rsiVelThresh

// === PLOT INDIVIDUAL ===
plot(showIndividual and show1 ? f1_raw : na,
     "DSS 3/2", color.new(#FF6B6B, 60),
     linewidth=1)
plot(showIndividual and show2 ? f2_raw : na,
     "DSS 5/3", color.new(#FFA07A, 60),
     linewidth=1)
plot(showIndividual and show3 ? f3_raw : na,
     "DSS 8/3", color.new(#FFD700, 60),
     linewidth=1)
plot(showIndividual and show4 ? f4_raw : na,
     "DSS 8/5", color.new(#90EE90, 60),
     linewidth=1)
plot(showIndividual and show5 ? f5_raw : na,
     "DSS 13/5", color.new(#87CEEB, 60),
     linewidth=1)
plot(showIndividual and show6 ? f6_raw : na,
     "DSS 13/8", color.new(#DDA0DD, 60),
     linewidth=1)

// === PLOT COMBINED ===
combColor = displayCombined > 10 ? #D50000 :
     displayCombined > 5  ? #EF5350 :
     displayCombined > 0  ? #FFCDD2 :
     displayCombined > -5 ? #B9F6CA :
     displayCombined > -10 ? #69F0AE :
     #00C853

plot(showCombined ? displayCombined : na,
     "Combined Forecast", combColor,
     linewidth=3)

// === REFERENCE LINES ===
hline(20,  "Cap (+20)",
     color.new(#D50000, 70), hline.style_dashed)
hline(10,  "Strong (+10)",
     color.new(#EF5350, 70), hline.style_dotted)
hline(0,   "Neutral",
     color.new(#888888, 50), hline.style_solid)
hline(-10, "Strong (-10)",
     color.new(#69F0AE, 70), hline.style_dotted)
hline(-20, "Cap (-20)",
     color.new(#00C853, 70), hline.style_dashed)

// === BACKGROUND ZONES ===
bgcolor(displayCombined > 10 ?
     color.new(#D50000, 92) :
     displayCombined < -10 ?
     color.new(#00C853, 92) : na)

// === FLIP SIGNALS (scalp-tuned) ===
grpFlip = "Flip Signals"
showFlips = input.bool(true,
     "Show Flip Signals", group=grpFlip)
confirmBars = input.int(1, "Confirmation Bars",
     group=grpFlip, minval=1, maxval=5,
     tooltip="1-2 for scalps (fast entry)")
flipCooldown = input.int(8,
     "Signal Cooldown (bars)",
     group=grpFlip, minval=1, maxval=50,
     tooltip="8 bars on 5m = 40 min cooldown")
volLen = input.int(14, "Volume MA Length",
     group=grpFlip)
volMult = input.float(0.8,
     "Volume Threshold (x avg)",
     group=grpFlip, step=0.1,
     tooltip="0.8 = slightly below avg OK " +
     "for scalps")

// Stack detection — all 6 aligned
bearStack = f1_raw < 0 and f2_raw < 0 and
     f3_raw < 0 and f4_raw < 0 and
     f5_raw < 0 and f6_raw < 0
bullStack = f1_raw > 0 and f2_raw > 0 and
     f3_raw > 0 and f4_raw > 0 and
     f5_raw > 0 and f6_raw > 0

// Track stack break duration
var int bearBrokenCount = 0
var int bullBrokenCount = 0
bearBrokenCount := bearStack ? 0 :
     bearStack[1] ? 1 :
     bearBrokenCount > 0 ?
     bearBrokenCount + 1 : 0
bullBrokenCount := bullStack ? 0 :
     bullStack[1] ? 1 :
     bullBrokenCount > 0 ?
     bullBrokenCount + 1 : 0

// Volume confirmation
avgVol = ta.sma(volume, volLen)
volConfirm = volume > avgVol * volMult

// Raw signals — stack broken + volume + momentum
rawBuy = bearBrokenCount == confirmBars and
     volConfirm and momBullOk
rawSell = bullBrokenCount == confirmBars and
     volConfirm and momBearOk

// Cooldown
barsSinceBuy = ta.barssince(rawBuy[1])
barsSinceSell = ta.barssince(rawSell[1])
buySignal = rawBuy and (na(barsSinceBuy) or
     barsSinceBuy >= flipCooldown)
sellSignal = rawSell and (na(barsSinceSell) or
     barsSinceSell >= flipCooldown)

// Plot signals
plotshape(showFlips and buySignal ?
     displayCombined : na,
     "Buy Signal", shape.triangleup,
     location.absolute,
     color=color.new(#00C853, 0),
     size=size.small)
plotshape(showFlips and sellSignal ?
     displayCombined : na,
     "Sell Signal", shape.triangledown,
     location.absolute,
     color=color.new(#D50000, 0),
     size=size.small)

// === ZERO-CROSS SCALP SIGNALS ===
// Quick entries when combined crosses zero
// with momentum confirmation
grpZero = "Zero-Cross Signals"
showZeroCross = input.bool(true,
     "Show Zero-Cross Entries", group=grpZero)
zeroCooldown = input.int(5,
     "Zero-Cross Cooldown",
     group=grpZero, minval=1, maxval=30)

zeroBuy = combined > 0 and combined[1] <= 0 and
     momBullOk
zeroSell = combined < 0 and combined[1] >= 0 and
     momBearOk

barsSinceZB = ta.barssince(zeroBuy[1])
barsSinceZS = ta.barssince(zeroSell[1])
zeroBuyFinal = zeroBuy and (na(barsSinceZB) or
     barsSinceZB >= zeroCooldown)
zeroSellFinal = zeroSell and (na(barsSinceZS) or
     barsSinceZS >= zeroCooldown)

plotshape(showZeroCross and zeroBuyFinal ?
     0.0 : na,
     "Zero Buy", shape.circle,
     location.absolute,
     color=color.new(#2979FF, 0),
     size=size.tiny)
plotshape(showZeroCross and zeroSellFinal ?
     0.0 : na,
     "Zero Sell", shape.circle,
     location.absolute,
     color=color.new(#FF6D00, 0),
     size=size.tiny)

// === AGREEMENT COUNTER ===
bullCount = (show1 and f1_raw > 0 ? 1 : 0) +
     (show2 and f2_raw > 0 ? 1 : 0) +
     (show3 and f3_raw > 0 ? 1 : 0) +
     (show4 and f4_raw > 0 ? 1 : 0) +
     (show5 and f5_raw > 0 ? 1 : 0) +
     (show6 and f6_raw > 0 ? 1 : 0)
bearCount = (show1 and f1_raw < 0 ? 1 : 0) +
     (show2 and f2_raw < 0 ? 1 : 0) +
     (show3 and f3_raw < 0 ? 1 : 0) +
     (show4 and f4_raw < 0 ? 1 : 0) +
     (show5 and f5_raw < 0 ? 1 : 0) +
     (show6 and f6_raw < 0 ? 1 : 0)
activeCount = (show1 ? 1 : 0) + (show2 ? 1 : 0) +
     (show3 ? 1 : 0) + (show4 ? 1 : 0) +
     (show5 ? 1 : 0) + (show6 ? 1 : 0)

// === FORECAST VELOCITY ===
// How fast the combined forecast is moving
fcVel = combined - combined[3]
fcAccel = fcVel - fcVel[2]

// === INFO TABLE ===
var table info = table.new(position.top_right,
     3, 12,
     bgcolor=color.new(#1a1a2e, 10),
     border_width=1,
     border_color=color.new(#333355, 50))

if barstate.islast
    table.cell(info, 0, 0, "DSS",
         text_color=#aaaacc, text_size=size.small)
    table.cell(info, 1, 0, "FC",
         text_color=#aaaacc, text_size=size.small)
    table.cell(info, 2, 0, "Vel",
         text_color=#aaaacc, text_size=size.small)

    row = 1
    if show1
        table.cell(info, 0, row, "3/2",
             text_color=#FF6B6B,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f1_raw, "#.#"),
             text_color=f1_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f1vel = f1_raw - f1_raw[2]
        table.cell(info, 2, row,
             (f1vel > 0 ? "+" : "") +
             str.tostring(f1vel, "#.#"),
             text_color=f1vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show2
        table.cell(info, 0, row, "5/3",
             text_color=#FFA07A,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f2_raw, "#.#"),
             text_color=f2_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f2vel = f2_raw - f2_raw[2]
        table.cell(info, 2, row,
             (f2vel > 0 ? "+" : "") +
             str.tostring(f2vel, "#.#"),
             text_color=f2vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show3
        table.cell(info, 0, row, "8/3",
             text_color=#FFD700,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f3_raw, "#.#"),
             text_color=f3_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f3vel = f3_raw - f3_raw[2]
        table.cell(info, 2, row,
             (f3vel > 0 ? "+" : "") +
             str.tostring(f3vel, "#.#"),
             text_color=f3vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show4
        table.cell(info, 0, row, "8/5",
             text_color=#90EE90,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f4_raw, "#.#"),
             text_color=f4_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f4vel = f4_raw - f4_raw[2]
        table.cell(info, 2, row,
             (f4vel > 0 ? "+" : "") +
             str.tostring(f4vel, "#.#"),
             text_color=f4vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show5
        table.cell(info, 0, row, "13/5",
             text_color=#87CEEB,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f5_raw, "#.#"),
             text_color=f5_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f5vel = f5_raw - f5_raw[2]
        table.cell(info, 2, row,
             (f5vel > 0 ? "+" : "") +
             str.tostring(f5vel, "#.#"),
             text_color=f5vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show6
        table.cell(info, 0, row, "13/8",
             text_color=#DDA0DD,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f6_raw, "#.#"),
             text_color=f6_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f6vel = f6_raw - f6_raw[2]
        table.cell(info, 2, row,
             (f6vel > 0 ? "+" : "") +
             str.tostring(f6vel, "#.#"),
             text_color=f6vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1

    if showCombined
        table.cell(info, 0, row, "COMBINED",
             text_color=#ffffff,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(displayCombined, "#.#"),
             text_color=displayCombined > 0 ?
             #00C853 : #D50000,
             text_size=size.small)
        table.cell(info, 2, row,
             (fcVel > 0 ? "+" : "") +
             str.tostring(fcVel, "#.#"),
             text_color=fcVel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1

    // Agreement row
    table.cell(info, 0, row, "Agree",
         text_color=#aaaacc,
         text_size=size.small)
    agreeStr = bullCount > bearCount ?
         str.tostring(bullCount) + "/" +
         str.tostring(activeCount) + " BULL" :
         bearCount > bullCount ?
         str.tostring(bearCount) + "/" +
         str.tostring(activeCount) + " BEAR" :
         "SPLIT"
    agreeCol = bullCount == activeCount ?
         #00C853 :
         bearCount == activeCount ?
         #D50000 :
         bullCount > bearCount ? #69F0AE :
         bearCount > bullCount ? #EF5350 :
         #FFD700
    table.cell(info, 1, row, agreeStr,
         text_color=agreeCol,
         text_size=size.small)
    // Momentum in agreement column
    table.cell(info, 2, row,
         momBullOk ? "MOM ▲" :
         momBearOk ? "MOM ▼" : "MOM —",
         text_color=momBullOk ? #69F0AE :
         momBearOk ? #EF5350 : #888888,
         text_size=size.small)
    row += 1

    // Signal status
    sigTxt = buySignal ? "FLIP BUY" :
         sellSignal ? "FLIP SELL" :
         zeroBuyFinal ? "ZERO BUY" :
         zeroSellFinal ? "ZERO SELL" : "—"
    sigCol = buySignal ? #00C853 :
         sellSignal ? #D50000 :
         zeroBuyFinal ? #2979FF :
         zeroSellFinal ? #FF6D00 : #888888
    table.cell(info, 0, row, "SIG",
         text_color=#aaaacc,
         text_size=size.small)
    table.cell(info, 1, row, sigTxt,
         text_color=sigCol,
         text_size=size.small)
    table.cell(info, 2, row, "",
         text_size=size.small)

// === ALERTS ===
alertcondition(buySignal,
     "Flip Buy",
     '{"signal":"buy","type":"flip"}')
alertcondition(sellSignal,
     "Flip Sell",
     '{"signal":"sell","type":"flip"}')
alertcondition(zeroBuyFinal,
     "Zero-Cross Buy",
     '{"signal":"buy","type":"zero_cross"}')
alertcondition(zeroSellFinal,
     "Zero-Cross Sell",
     '{"signal":"sell","type":"zero_cross"}')
alertcondition(buySignal or zeroBuyFinal,
     "Any Buy",
     '{"signal":"buy","type":"any"}')
alertcondition(sellSignal or zeroSellFinal,
     "Any Sell",
     '{"signal":"sell","type":"any"}')
