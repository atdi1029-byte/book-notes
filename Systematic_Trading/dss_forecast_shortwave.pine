//@version=6
indicator("DSS Forecast Short Wave",
     overlay=false, precision=2)

// Short-wave DSS Forecast: same Carver framework
// but shifted to faster periods for catching
// intermediate cycles between major swings.
// Original: 5/3, 8/5, 13/8, 21/8, 34/13, 55/13
// Short wave: 2/2, 3/2, 5/3, 8/3, 13/5
// Best on 15m to 4H charts, or Daily for swing.

// === SETTINGS ===
grpDSS = "DSS Pairs"
show1 = input.bool(true,  "DSS 2/2 (fastest)",
     group=grpDSS)
show2 = input.bool(true,  "DSS 3/2",
     group=grpDSS)
show3 = input.bool(true,  "DSS 5/3",
     group=grpDSS)
show4 = input.bool(true,  "DSS 8/3",
     group=grpDSS)
show5 = input.bool(true,  "DSS 13/5 (slowest)",
     group=grpDSS)

grpComb = "Combined Forecast"
showCombined = input.bool(true,
     "Show Combined Forecast", group=grpComb)
divMultiplier = input.float(1.31,
     "Diversification Multiplier",
     group=grpComb, minval=1.0, maxval=2.5,
     step=0.01,
     tooltip="Carver default 1.31. Higher = " +
     "more aggressive position sizing")
smoothLen = input.int(5, "Smoothing EMA",
     group=grpComb, minval=1, maxval=20,
     tooltip="EMA applied to combined forecast. " +
     "1 = no smoothing. 5 = default, tames chop")

grpWt = "Forecast Weights (must sum to 100)"
w1 = input.float(15, "Weight: DSS 2/2",
     group=grpWt, minval=0, maxval=100)
w2 = input.float(20, "Weight: DSS 3/2",
     group=grpWt, minval=0, maxval=100)
w3 = input.float(25, "Weight: DSS 5/3",
     group=grpWt, minval=0, maxval=100)
w4 = input.float(22, "Weight: DSS 8/3",
     group=grpWt, minval=0, maxval=100)
w5 = input.float(18, "Weight: DSS 13/5",
     group=grpWt, minval=0, maxval=100)

grpHTF = "Higher Timeframe"
showHTF = input.bool(false,
     "Remap to Higher TF", group=grpHTF)
htfTF = input.timeframe("60", "Timeframe",
     group=grpHTF)

grpMom = "Momentum Gate"
useMomGate = input.bool(true,
     "RSI Velocity Filter", group=grpMom,
     tooltip="Require RSI momentum aligned " +
     "with signal direction")
rsiLen = input.int(9, "RSI Length",
     group=grpMom, minval=2, maxval=21)
rsiVelLen = input.int(2, "Velocity Lookback",
     group=grpMom, minval=1, maxval=8,
     tooltip="Bars to measure RSI change over")
rsiVelThresh = input.float(1.5,
     "Min Velocity",
     group=grpMom, minval=0.5, maxval=10.0,
     step=0.5,
     tooltip="Minimum RSI change over lookback")

grpVis = "Visual"
showIndividual = input.bool(false,
     "Show Individual Forecasts", group=grpVis)

// === DSS BRESSERT FUNCTION ===
dss_bressert(float src, int stochLen,
     int emaLen) =>
    hh = ta.highest(src, stochLen)
    ll = ta.lowest(src, stochLen)
    raw1 = hh != ll ?
         (src - ll) / (hh - ll) * 100 : 50.0
    smooth1 = ta.ema(raw1, emaLen)
    hh2 = ta.highest(smooth1, stochLen)
    ll2 = ta.lowest(smooth1, stochLen)
    raw2 = hh2 != ll2 ?
         (smooth1 - ll2) / (hh2 - ll2) * 100
         : 50.0
    dssLine = ta.ema(raw2, emaLen)
    dssLine

// === DSS FORECAST (0-100 -> +-20) ===
dss_fc(int stochLen, int emaLen) =>
    dss = dss_bressert(close, stochLen, emaLen)
    math.max(-20.0, math.min(20.0,
         dss * 0.4 - 20.0))

// === INDIVIDUAL FORECASTS ===
f1_raw = dss_fc(2, 2)
f2_raw = dss_fc(3, 2)
f3_raw = dss_fc(5, 3)
f4_raw = dss_fc(8, 3)
f5_raw = dss_fc(13, 5)

// === COMBINED FORECAST ===
totalWeight = (show1 ? w1 : 0) +
     (show2 ? w2 : 0) +
     (show3 ? w3 : 0) + (show4 ? w4 : 0) +
     (show5 ? w5 : 0)

weightedSum = (show1 ? f1_raw * w1 : 0) +
     (show2 ? f2_raw * w2 : 0) +
     (show3 ? f3_raw * w3 : 0) +
     (show4 ? f4_raw * w4 : 0) +
     (show5 ? f5_raw * w5 : 0)

rawCombined = totalWeight > 0 ?
     weightedSum / totalWeight : 0.0
scaledCombined = rawCombined * divMultiplier
combined = math.max(-20.0,
     math.min(20.0, scaledCombined))

// === SMOOTHING ===
smoothedCombined = smoothLen > 1 ?
     ta.ema(combined, smoothLen) : combined

// === HIGHER TIMEFRAME ===
htfRaw = request.security(syminfo.tickerid,
     htfTF, smoothedCombined)
htfSmoothed = ta.ema(htfRaw, 4)
displayCombined = showHTF ? htfSmoothed :
     smoothedCombined

// === RSI MOMENTUM GATE ===
rsiVal = ta.rsi(close, rsiLen)
rsiVelocity = rsiVal - rsiVal[rsiVelLen]
momBullOk = not useMomGate or
     rsiVelocity > rsiVelThresh
momBearOk = not useMomGate or
     rsiVelocity < -rsiVelThresh

// === AGREEMENT COUNTER ===
bullCount = (show1 and f1_raw > 0 ? 1 : 0) +
     (show2 and f2_raw > 0 ? 1 : 0) +
     (show3 and f3_raw > 0 ? 1 : 0) +
     (show4 and f4_raw > 0 ? 1 : 0) +
     (show5 and f5_raw > 0 ? 1 : 0)
bearCount = (show1 and f1_raw < 0 ? 1 : 0) +
     (show2 and f2_raw < 0 ? 1 : 0) +
     (show3 and f3_raw < 0 ? 1 : 0) +
     (show4 and f4_raw < 0 ? 1 : 0) +
     (show5 and f5_raw < 0 ? 1 : 0)
activeCount = (show1 ? 1 : 0) + (show2 ? 1 : 0) +
     (show3 ? 1 : 0) + (show4 ? 1 : 0) +
     (show5 ? 1 : 0)

// === FORECAST VELOCITY & ACCELERATION ===
fcVel = combined - combined[2]
fcAccel = fcVel - fcVel[1]

// === FASTEST vs SLOWEST SPREAD ===
fastSlow = f1_raw - f5_raw

// === SPREAD (all compressed?) ===
fcMax = math.max(f1_raw,
     math.max(f2_raw,
     math.max(f3_raw,
     math.max(f4_raw, f5_raw))))
fcMin = math.min(f1_raw,
     math.min(f2_raw,
     math.min(f3_raw,
     math.min(f4_raw, f5_raw))))
fcSpread = fcMax - fcMin


// =========================================================
// SIGNAL 1: FULL STACK FLIP
// =========================================================
grpFlip = "Stack Flip"
showFlips = input.bool(true,
     "Show Stack Flips", group=grpFlip)
confirmBars = input.int(2, "Confirmation Bars",
     group=grpFlip, minval=1, maxval=10)
flipCooldown = input.int(8,
     "Cooldown (bars)",
     group=grpFlip, minval=1, maxval=50)
volLen = input.int(14, "Volume MA Length",
     group=grpFlip)
volMult = input.float(0.8,
     "Volume Threshold (x avg)",
     group=grpFlip, step=0.1)

bearStack = f1_raw < 0 and f2_raw < 0 and
     f3_raw < 0 and f4_raw < 0 and f5_raw < 0
bullStack = f1_raw > 0 and f2_raw > 0 and
     f3_raw > 0 and f4_raw > 0 and f5_raw > 0

var int bearBrokenCount = 0
var int bullBrokenCount = 0
bearBrokenCount := bearStack ? 0 :
     bearStack[1] ? 1 :
     bearBrokenCount > 0 ?
     bearBrokenCount + 1 : 0
bullBrokenCount := bullStack ? 0 :
     bullStack[1] ? 1 :
     bullBrokenCount > 0 ?
     bullBrokenCount + 1 : 0

avgVol = ta.sma(volume, volLen)
volConfirm = volume > avgVol * volMult

rawBuy = bearBrokenCount == confirmBars and
     volConfirm and momBullOk
rawSell = bullBrokenCount == confirmBars and
     volConfirm and momBearOk

barsSinceBuy = ta.barssince(rawBuy[1])
barsSinceSell = ta.barssince(rawSell[1])
buySignal = rawBuy and (na(barsSinceBuy) or
     barsSinceBuy >= flipCooldown)
sellSignal = rawSell and (na(barsSinceSell) or
     barsSinceSell >= flipCooldown)


// =========================================================
// SIGNAL 2: EXTREME REVERSAL
// =========================================================
grpExt = "Extreme Reversal"
showExtreme = input.bool(true,
     "Show Extreme Reversals", group=grpExt)
extThresh = input.float(14.0,
     "Extreme Threshold",
     group=grpExt, minval=10.0, maxval=20.0,
     step=1.0)
extCooldown = input.int(5,
     "Cooldown (bars)",
     group=grpExt, minval=1, maxval=30)

extBuyRaw = combined <= -extThresh and
     f1_raw > f1_raw[1] and
     f1_raw[1] <= f1_raw[2]
extSellRaw = combined >= extThresh and
     f1_raw < f1_raw[1] and
     f1_raw[1] >= f1_raw[2]

barsSinceEB = ta.barssince(extBuyRaw[1])
barsSinceES = ta.barssince(extSellRaw[1])
extBuyFinal = extBuyRaw and (na(barsSinceEB) or
     barsSinceEB >= extCooldown)
extSellFinal = extSellRaw and (na(barsSinceES) or
     barsSinceES >= extCooldown)


// =========================================================
// SIGNAL 3: ZERO-CROSS MOMENTUM BURST
// Fast oscillators cross zero together with
// acceleration — catches the snap moves
// =========================================================
grpZero = "Zero-Cross Burst"
showZeroCross = input.bool(true,
     "Show Zero-Cross Bursts", group=grpZero)
zeroCooldown = input.int(6,
     "Cooldown (bars)",
     group=grpZero, minval=1, maxval=30)

// At least 3 of 5 cross zero in same direction
// within last 2 bars, with acceleration
f1cross_bull = f1_raw > 0 and f1_raw[2] <= 0
f2cross_bull = f2_raw > 0 and f2_raw[2] <= 0
f3cross_bull = f3_raw > 0 and f3_raw[2] <= 0
f4cross_bull = f4_raw > 0 and f4_raw[2] <= 0
f5cross_bull = f5_raw > 0 and f5_raw[2] <= 0

f1cross_bear = f1_raw < 0 and f1_raw[2] >= 0
f2cross_bear = f2_raw < 0 and f2_raw[2] >= 0
f3cross_bear = f3_raw < 0 and f3_raw[2] >= 0
f4cross_bear = f4_raw < 0 and f4_raw[2] >= 0
f5cross_bear = f5_raw < 0 and f5_raw[2] >= 0

bullCrossCount = (f1cross_bull ? 1 : 0) +
     (f2cross_bull ? 1 : 0) +
     (f3cross_bull ? 1 : 0) +
     (f4cross_bull ? 1 : 0) +
     (f5cross_bull ? 1 : 0)
bearCrossCount = (f1cross_bear ? 1 : 0) +
     (f2cross_bear ? 1 : 0) +
     (f3cross_bear ? 1 : 0) +
     (f4cross_bear ? 1 : 0) +
     (f5cross_bear ? 1 : 0)

zeroBuyRaw = bullCrossCount >= 3 and
     fcAccel > 0 and momBullOk
zeroSellRaw = bearCrossCount >= 3 and
     fcAccel < 0 and momBearOk

barsSinceZB = ta.barssince(zeroBuyRaw[1])
barsSinceZS = ta.barssince(zeroSellRaw[1])
zeroBuyFinal = zeroBuyRaw and
     (na(barsSinceZB) or
     barsSinceZB >= zeroCooldown)
zeroSellFinal = zeroSellRaw and
     (na(barsSinceZS) or
     barsSinceZS >= zeroCooldown)


// =========================================================
// PLOTTING
// =========================================================

// === INDIVIDUAL FORECASTS ===
plot(showIndividual and show1 ? f1_raw : na,
     "DSS 2/2", color.new(#FF6B6B, 60),
     linewidth=1)
plot(showIndividual and show2 ? f2_raw : na,
     "DSS 3/2", color.new(#FFA07A, 60),
     linewidth=1)
plot(showIndividual and show3 ? f3_raw : na,
     "DSS 5/3", color.new(#FFD700, 60),
     linewidth=1)
plot(showIndividual and show4 ? f4_raw : na,
     "DSS 8/3", color.new(#90EE90, 60),
     linewidth=1)
plot(showIndividual and show5 ? f5_raw : na,
     "DSS 13/5", color.new(#87CEEB, 60),
     linewidth=1)

// === COMBINED ===
combColor = displayCombined > 10 ? #D50000 :
     displayCombined > 5  ? #EF5350 :
     displayCombined > 0  ? #FFCDD2 :
     displayCombined > -5 ? #B9F6CA :
     displayCombined > -10 ? #69F0AE :
     #00C853

plot(showCombined ? displayCombined : na,
     "Combined Forecast", combColor,
     linewidth=3)

// === REFERENCE LINES ===
hline(20,  "Cap (+20)",
     color.new(#D50000, 70), hline.style_dashed)
hline(10,  "Strong (+10)",
     color.new(#EF5350, 70), hline.style_dotted)
hline(0,   "Neutral",
     color.new(#888888, 50), hline.style_solid)
hline(-10, "Strong (-10)",
     color.new(#69F0AE, 70), hline.style_dotted)
hline(-20, "Cap (-20)",
     color.new(#00C853, 70), hline.style_dashed)

// === BACKGROUND ZONES ===
bgcolor(displayCombined > 10 ?
     color.new(#D50000, 92) :
     displayCombined < -10 ?
     color.new(#00C853, 92) : na)

// === SIGNALS ===
// Stack flip -- triangles
plotshape(showFlips and buySignal ?
     displayCombined : na,
     "Stack Buy", shape.triangleup,
     location.bottom,
     color=color.new(#00C853, 0),
     size=size.tiny)
plotshape(showFlips and sellSignal ?
     displayCombined : na,
     "Stack Sell", shape.triangledown,
     location.top,
     color=color.new(#D50000, 0),
     size=size.tiny)

// Extreme reversal -- X marks
plotshape(showExtreme and extBuyFinal ?
     displayCombined : na,
     "Extreme Buy", shape.xcross,
     location.bottom,
     color=color.new(#00C853, 0),
     size=size.tiny)
plotshape(showExtreme and extSellFinal ?
     displayCombined : na,
     "Extreme Sell", shape.xcross,
     location.top,
     color=color.new(#FF1744, 0),
     size=size.tiny)

// Zero-cross burst -- diamonds
plotshape(showZeroCross and zeroBuyFinal ?
     displayCombined : na,
     "Zero Buy", shape.diamond,
     location.bottom,
     color=color.new(#76FF03, 0),
     size=size.tiny)
plotshape(showZeroCross and zeroSellFinal ?
     displayCombined : na,
     "Zero Sell", shape.diamond,
     location.top,
     color=color.new(#FF6D00, 0),
     size=size.tiny)


// =========================================================
// INFO TABLE
// =========================================================
var table info = table.new(position.top_right,
     3, 12,
     bgcolor=color.new(#1a1a2e, 10),
     border_width=1,
     border_color=color.new(#333355, 50))

if barstate.islast
    table.cell(info, 0, 0, "DSS",
         text_color=#aaaacc, text_size=size.small)
    table.cell(info, 1, 0, "FC",
         text_color=#aaaacc, text_size=size.small)
    table.cell(info, 2, 0, "Vel",
         text_color=#aaaacc, text_size=size.small)

    row = 1
    if show1
        table.cell(info, 0, row, "2/2",
             text_color=#FF6B6B,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f1_raw, "#.#"),
             text_color=f1_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f1vel = f1_raw - f1_raw[2]
        table.cell(info, 2, row,
             (f1vel > 0 ? "+" : "") +
             str.tostring(f1vel, "#.#"),
             text_color=f1vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show2
        table.cell(info, 0, row, "3/2",
             text_color=#FFA07A,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f2_raw, "#.#"),
             text_color=f2_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f2vel = f2_raw - f2_raw[2]
        table.cell(info, 2, row,
             (f2vel > 0 ? "+" : "") +
             str.tostring(f2vel, "#.#"),
             text_color=f2vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show3
        table.cell(info, 0, row, "5/3",
             text_color=#FFD700,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f3_raw, "#.#"),
             text_color=f3_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f3vel = f3_raw - f3_raw[2]
        table.cell(info, 2, row,
             (f3vel > 0 ? "+" : "") +
             str.tostring(f3vel, "#.#"),
             text_color=f3vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show4
        table.cell(info, 0, row, "8/3",
             text_color=#90EE90,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f4_raw, "#.#"),
             text_color=f4_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f4vel = f4_raw - f4_raw[2]
        table.cell(info, 2, row,
             (f4vel > 0 ? "+" : "") +
             str.tostring(f4vel, "#.#"),
             text_color=f4vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1
    if show5
        table.cell(info, 0, row, "13/5",
             text_color=#87CEEB,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(f5_raw, "#.#"),
             text_color=f5_raw > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        f5vel = f5_raw - f5_raw[2]
        table.cell(info, 2, row,
             (f5vel > 0 ? "+" : "") +
             str.tostring(f5vel, "#.#"),
             text_color=f5vel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1

    if showCombined
        table.cell(info, 0, row, "COMB",
             text_color=#ffffff,
             text_size=size.small)
        table.cell(info, 1, row,
             str.tostring(displayCombined,
             "#.#"),
             text_color=displayCombined > 0 ?
             #00C853 : #D50000,
             text_size=size.small)
        table.cell(info, 2, row,
             (fcVel > 0 ? "+" : "") +
             str.tostring(fcVel, "#.#"),
             text_color=fcVel > 0 ?
             #69F0AE : #EF5350,
             text_size=size.small)
        row += 1

    // Agreement
    table.cell(info, 0, row, "Agree",
         text_color=#aaaacc,
         text_size=size.small)
    agreeStr = bullCount > bearCount ?
         str.tostring(bullCount) + "/" +
         str.tostring(activeCount) + " BULL" :
         bearCount > bullCount ?
         str.tostring(bearCount) + "/" +
         str.tostring(activeCount) + " BEAR" :
         "SPLIT"
    agreeCol = bullCount == activeCount ?
         #00C853 :
         bearCount == activeCount ?
         #D50000 :
         bullCount > bearCount ? #69F0AE :
         bearCount > bullCount ? #EF5350 :
         #FFD700
    table.cell(info, 1, row, agreeStr,
         text_color=agreeCol,
         text_size=size.small)
    table.cell(info, 2, row,
         momBullOk ? "MOM ^" :
         momBearOk ? "MOM v" : "MOM -",
         text_color=momBullOk ? #69F0AE :
         momBearOk ? #EF5350 : #888888,
         text_size=size.small)
    row += 1

    // Spread
    table.cell(info, 0, row, "Spread",
         text_color=#aaaacc,
         text_size=size.small)
    table.cell(info, 1, row,
         str.tostring(fcSpread, "#.#"),
         text_color=#888888,
         text_size=size.small)
    table.cell(info, 2, row, "",
         text_size=size.small)
    row += 1

    // Fast vs Slow
    table.cell(info, 0, row, "F-S",
         text_color=#aaaacc,
         text_size=size.small)
    table.cell(info, 1, row,
         (fastSlow > 0 ? "+" : "") +
         str.tostring(fastSlow, "#.#"),
         text_color=fastSlow > 15 ? #76FF03 :
         fastSlow < -15 ? #FF1744 :
         fastSlow > 0 ? #69F0AE :
         fastSlow < 0 ? #EF5350 : #888888,
         text_size=size.small)
    fsLabel = math.abs(fastSlow) > 20 ?
         "TENSION" :
         math.abs(fastSlow) > 12 ?
         "BUILDING" : ""
    table.cell(info, 2, row, fsLabel,
         text_color=math.abs(fastSlow) > 20 ?
         #FFD740 :
         math.abs(fastSlow) > 12 ?
         #FFAB40 : #888888,
         text_size=size.small)
    row += 1

    // Active signal
    sigTxt = buySignal ? "^ STACK" :
         sellSignal ? "v STACK" :
         extBuyFinal ? "^ EXTRM" :
         extSellFinal ? "v EXTRM" :
         zeroBuyFinal ? "^ ZERO" :
         zeroSellFinal ? "v ZERO" : ""
    sigCol = buySignal or extBuyFinal or
         zeroBuyFinal ? #00C853 :
         sellSignal or extSellFinal or
         zeroSellFinal ? #D50000 : #888888
    table.cell(info, 0, row, "SIG",
         text_color=#aaaacc,
         text_size=size.small)
    table.cell(info, 1, row, sigTxt,
         text_color=sigCol,
         text_size=size.small)
    table.cell(info, 2, row, "",
         text_size=size.small)


// =========================================================
// ALERTS
// =========================================================
anyBuy = buySignal or extBuyFinal or
     zeroBuyFinal
anySell = sellSignal or extSellFinal or
     zeroSellFinal

alertcondition(anyBuy or anySell,
     "Any Signal",
     '{"signal":"{{ticker}}",' +
     '"type":"dss_shortwave"}')
