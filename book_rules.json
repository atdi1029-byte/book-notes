{
  "_comment": "Machine-readable book page rules, read by check_html.py. Section titles are matched at the start of the <h2> text (after any numbering). The prose version is PIPELINE.md; keep them in step.",
  "section_order": [
    {
      "key": "glossary",
      "title": "Glossary",
      "match": "^glossary",
      "required": "for_types",
      "types": [
        "textbook",
        "technical",
        "practical",
        "fitness"
      ]
    },
    {
      "key": "ten_things",
      "title": "If You Only Remember 10 Things",
      "match": "^(if you only remember|only remember|remember (10|ten)|the (10|ten) things|(10|ten) things)",
      "required": true
    },
    {
      "key": "chapters",
      "title": "Chapter-by-chapter coverage",
      "match": null,
      "required": true
    },
    {
      "key": "skipped",
      "title": "What Can Be Safely Skipped",
      "match": "^(what can be )?safely skipped|^what (you )?can (safely )?skip|^safe to skip",
      "required": true
    },
    {
      "key": "trading",
      "title": "Trading & Investing Lessons (fitness books: Programming Takeaways)",
      "match": "^(trading|investing)( (&|and) (investing|trading))? lessons|^lessons for (traders|investors)|^programming takeaways",
      "required": true
    },
    {
      "key": "takeaways",
      "title": "Key Takeaways",
      "match": "^key takeaways",
      "required": true
    },
    {
      "key": "contrarian",
      "title": "Contrarian Ideas",
      "match": "^contrarian",
      "required": true
    },
    {
      "key": "quotes",
      "title": "Notable Quotes",
      "match": "^(notable|memorable) quotes",
      "required": true
    },
    {
      "key": "allegories",
      "title": "Allegories & Cultural References",
      "match": "^(allegor|cultural references)",
      "required": true
    },
    {
      "key": "frameworks",
      "title": "Proposals/Frameworks",
      "match": "^(the )?(author.s )?(key )?(proposals|frameworks)",
      "required": false
    },
    {
      "key": "references",
      "title": "Referenced Works",
      "match": "^(referenced works|works referenced|books (&|and) thinkers|references\\b)",
      "required": true
    },
    {
      "key": "didnt_fit",
      "title": "What Didn't Fit",
      "match": "^what didn.?t fit|^what did not fit",
      "required": true
    },
    {
      "key": "footer",
      "title": "Footer",
      "match": "^footer$|^book details$",
      "required": false
    },
    {
      "key": "about_author",
      "title": "About the Author",
      "match": "^about the author",
      "required": true
    },
    {
      "key": "why_matters",
      "title": "Why This Book Matters",
      "match": "^why this book matters",
      "required": false
    }
  ],
  "chapter": {
    "part_header_match": "^part\\b",
    "min_paragraphs": 8,
    "min_avg_words": 80,
    "target_avg_words": 100,
    "depth_drop_ratio": 0.75,
    "combined_heading_match": "chapters?\\s+\\d+\\s*(-|–|—|&|and|to)\\s*\\d+"
  },
  "book": {
    "min_strong": 40,
    "min_blockquotes": 8,
    "ten_things_items": 10,
    "skipped_min_entries": 4,
    "skipped_max_entries": 8,
    "trading_min_lessons": 4,
    "subheaded_sections": [
      "takeaways",
      "contrarian"
    ],
    "didnt_fit_min_sentences": 5,
    "about_author_min_paragraphs": 2,
    "glossary_min_terms": 20,
    "allegories_columns": 2,
    "allegories_min_rows": 12,
    "references_columns": 3,
    "long_line_chars": 110,
    "long_line_share_warn": 0.25
  },
  "line_targets": {
    "_comment": "Soft targets (warning only) by template type; they depend on wrapping, so depth is judged per chapter instead.",
    "light": [
      800,
      1000
    ],
    "standard": [
      1200,
      1500
    ],
    "dense": [
      1500,
      2000
    ],
    "textbook": [
      3000,
      5000
    ]
  }
}