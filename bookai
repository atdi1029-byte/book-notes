echo "Batches merged this run: $MERGED   Cost this run: \$$COST" | tee -a "$LOG"
[ -n "$HAIKU_RUN" ] && echo "Written by haiku (flagged): $HAIKU_RUN" | tee -a "$LOG"
[ -n "$FAILED_RUN" ] && echo "Failed ranges: $FAILED_RUN" | tee -a "$LOG"
[ -f "$WORK/fatal" ] && echo "STOPPED EARLY: $(cat "$WORK/fatal") — re-run later to continue" | tee -a "$LOG"
echo "Notes:   $(wc -l < "$NOTES" | tr -d ' ') lines" | tee -a "$LOG"
echo "========================================" | tee -a "$LOG"

# === REORDER PASS ===
