#!/bin/bash
# bookai — Batch-process a PDF into notes.md using the Claude CLI
#
# Each batch of pages goes to its own `claude -p` call. bookai hands the model
# the page text (extracted with PyMuPDF) plus page images for pages with
# figures or no text layer, and the model writes that batch's notes. Batches
# run in parallel waves and are merged into notes.md in page order.
#
# Quality gates per batch: every page acknowledged (<!-- page N: … -->),
# word/bullet minimums scaled to the pages that have content, priority tags,
# figure descriptions for chart books, and a fabrication check (every "> quote"
# must be found in the PDF text, verify_quotes.py). A rejected batch is retried
# once on Sonnet with the reason, then split in half (down to 4 pages), and
# only then tried on Haiku — Haiku pages are recorded in .run_state.json.
#
# Re-running is safe and cheap: pages already acknowledged (.pages_done) are
# skipped, so a re-run only fills gaps. One run per book folder at a time
# (.bookai.lock). Ctrl-C stops every worker.
#
# Each claude call runs from an empty temp folder with only Read/Write, so it
# doesn't load CLAUDE.md, memory or MCP tools (~70% less fixed prompt per call).
#
# After extraction: reorder (page order + global [N###] IDs) → duplicate report
# (nothing is deleted) → verification → quote audit → .run_state.json.
# extraction.status is PASSED only when every page was extracted; otherwise
# INCOMPLETE (or DEGRADED when Haiku wrote some pages).
#
# Then: Claude writes summary.md / index.html (see PIPELINE.md), runs
#   ./check_html.py Folder  and  ./grade_coverage.py Folder, and
#   ./finish-book.sh "Book_Folder" --push   does everything mechanical.
#
# Usage:
#   ./bookai "/path/to/book.pdf" "Book_Folder" [start] [end] [batch] [sleep] [parallel] [--type=TYPE]
#   ./bookai "/path/to/book.pdf" /full/path/to/Book_Folder/notes.md   # also works (auto-extracts folder)
#
# Book types: analytical (default), narrative, technical, textbook, practical
#   analytical  — economics, macro, psychology. Signal over noise.
#   narrative   — history, biography. Keep timelines, maps, key episodes.
#   technical   — TA, trading, chart books. EVERY chart/example is content.
#   textbook    — quant finance, math. Formulas + worked examples preserved.
#   practical   — options, bonds. Step-by-step strategies + diagrams.
#
# Examples:
#   ./bookai "/path/to/book.pdf" "My_Book"              # auto-detect pages and type, defaults
#   ./bookai "/path/to/book.pdf" "My_Book" 1 300 20 5 3
#   ./bookai "/path/to/book.pdf" "My_Book" 1 0 10 5 1 --type=technical
#
# If --type is omitted the type is auto-suggested from the PDF's table of
# contents (detect_type.py); in a terminal you get 30s to accept or override.
#
# Requires: claude CLI, python3 with PyMuPDF (pip install pymupdf).
# Test hooks: BOOKAI_CLAUDE=/path/to/fake-claude, BOOKAI_BACKOFF=seconds.

set -euo pipefail

BOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$BOOKS_DIR/_python.sh"
LIB="$BOOKS_DIR/bookai_lib.py"
CLAUDE="${BOOKAI_CLAUDE:-claude}"
BACKOFF="${BOOKAI_BACKOFF:-60}"   # first wait after a rate limit (doubles each time)

usage() { sed -n '2,52p' "$0" | sed 's/^# \{0,1\}//'; exit 1; }

# Parse flags from any position
BOOK_TYPE="analytical"
TYPE_GIVEN=false
TYPE_SOURCE="default"
POSITIONAL=()
for arg in "$@"; do
  case "$arg" in
    --type=*) BOOK_TYPE="${arg#--type=}"; TYPE_GIVEN=true; TYPE_SOURCE="--type" ;;
    --ta) BOOK_TYPE="technical"; TYPE_GIVEN=true; TYPE_SOURCE="--ta" ;;  # backwards compat
    -h|--help) usage ;;
    *) POSITIONAL+=("$arg") ;;
  esac
done
[ ${#POSITIONAL[@]} -ge 2 ] || usage

PDF="${POSITIONAL[0]}"
RAW_FOLDER="${POSITIONAL[1]}"
START="${POSITIONAL[2]:-1}"
END_PAGE="${POSITIONAL[3]:-0}"

[ -f "$PDF" ] || { echo "ERROR: PDF not found: $PDF"; exit 1; }
PDF="$(cd "$(dirname "$PDF")" && pwd)/$(basename "$PDF")"

# Auto-suggest the book type from the PDF's front matter / TOC when --type is omitted
if [ "$TYPE_GIVEN" = false ] && [ -f "$BOOKS_DIR/detect_type.py" ]; then
  DETECTED=$(python3 "$BOOKS_DIR/detect_type.py" "$PDF" 2>/dev/null || true)
  case "$DETECTED" in analytical|narrative|technical|textbook|practical) ;; *) DETECTED="" ;; esac
  if [ -n "$DETECTED" ]; then
    if [ -t 0 ]; then
      ANS=""
      read -r -t 30 -p "Auto-detected book type: $DETECTED — Enter to accept, or type analytical/narrative/technical/textbook/practical: " ANS || true
      if [ -n "$ANS" ]; then BOOK_TYPE="$ANS"; TYPE_SOURCE="chosen at prompt"; else BOOK_TYPE="$DETECTED"; TYPE_SOURCE="auto-detected"; fi
    else
      BOOK_TYPE="$DETECTED"; TYPE_SOURCE="auto-detected"
    fi
  else
    echo "NOTE: could not auto-detect book type — using 'analytical' (pass --type=... to override)"
  fi
fi

# Validate book type
case "$BOOK_TYPE" in
  analytical|narrative|technical|textbook|practical) ;;
  *) echo "ERROR: Unknown book type '$BOOK_TYPE'. Use: analytical, narrative, technical, textbook, practical"; exit 1 ;;
esac
VISUAL=false
case "$BOOK_TYPE" in technical|practical|textbook) VISUAL=true ;; esac

# Adaptive defaults by book type — visual books need smaller batches, fewer parallel
case "$BOOK_TYPE" in
  technical)   BATCH="${POSITIONAL[4]:-10}" ; SLEEP="${POSITIONAL[5]:-5}" ; PARALLEL="${POSITIONAL[6]:-1}" ;;
  practical)   BATCH="${POSITIONAL[4]:-10}" ; SLEEP="${POSITIONAL[5]:-5}" ; PARALLEL="${POSITIONAL[6]:-2}" ;;
  textbook)    BATCH="${POSITIONAL[4]:-12}" ; SLEEP="${POSITIONAL[5]:-5}" ; PARALLEL="${POSITIONAL[6]:-2}" ;;
  *)           BATCH="${POSITIONAL[4]:-20}" ; SLEEP="${POSITIONAL[5]:-5}" ; PARALLEL="${POSITIONAL[6]:-3}" ;;
esac

# Normalize folder: if user passed a full path or a path ending in notes.md, extract just the folder name
if [[ "$RAW_FOLDER" == *"/notes.md" ]]; then
  FOLDER="$(basename "$(dirname "$RAW_FOLDER")")"
  echo "NOTE: Detected notes.md path — using folder name '$FOLDER' instead."
elif [[ "$RAW_FOLDER" == /* ]]; then
  FOLDER="$(basename "$RAW_FOLDER")"
  echo "NOTE: Detected absolute path — using folder name '$FOLDER' instead."
else
  FOLDER="$RAW_FOLDER"
fi

DIR="$BOOKS_DIR/$FOLDER"
NOTES="$DIR/notes.md"
LOG="$DIR/process.log"
PAGES_DONE="$DIR/.pages_done"
MODEL_LOG="$DIR/.model_usage.log"
STATE="$DIR/.run_state.json"

# Safety check: if notes.md exists as a directory, something went wrong previously
if [ -d "$NOTES" ]; then
  echo "ERROR: $NOTES is a directory, not a file. Remove it first: rm -rf '$NOTES'"
  exit 1
fi

# Page count (PyMuPDF everywhere; mdls is the macOS-only fallback)
TOTAL_PAGES=$(python3 -c "import sys
try:
    import pymupdf as fitz
except ImportError:
    import fitz
print(len(fitz.open(sys.argv[1])))" "$PDF" 2>/dev/null || true)
if ! [[ "$TOTAL_PAGES" =~ ^[0-9]+$ ]] && command -v mdls >/dev/null 2>&1; then
  TOTAL_PAGES=$(mdls -name kMDItemNumberOfPages "$PDF" 2>/dev/null | awk '{print $NF}')
fi
if ! [[ "${TOTAL_PAGES:-}" =~ ^[0-9]+$ ]] || [ "$TOTAL_PAGES" -eq 0 ]; then
  echo "ERROR: Could not detect page count (pip install pymupdf)."
  exit 1
fi
if [ "$END_PAGE" -eq 0 ] || [ "$END_PAGE" -gt "$TOTAL_PAGES" ]; then END_PAGE=$TOTAL_PAGES; fi

mkdir -p "$DIR"
touch "$NOTES" "$PAGES_DONE"

# ── One run per folder ────────────────────────────────────────────────────
LOCK="$DIR/.bookai.lock"
if ! mkdir "$LOCK" 2>/dev/null; then
  OTHER=$(cat "$LOCK/pid" 2>/dev/null || true)
  if [ -n "$OTHER" ] && kill -0 "$OTHER" 2>/dev/null; then
    echo "ERROR: another bookai run (pid $OTHER) is already working on $FOLDER (lock: $LOCK)"
    exit 1
  fi
  echo "NOTE: removing a stale lock left by a run that is no longer running"
  rm -rf "$LOCK"
  mkdir "$LOCK"
fi
echo $$ > "$LOCK/pid"

# Scratch space outside the home folder: claude calls run from here, so they
# don't pick up /Users/.../CLAUDE.md or project memory.
WORK="$(mktemp -d "${TMPDIR:-/tmp}/bookai.XXXXXX")"

killtree() {
  local c
  for c in $(pgrep -P "$1" 2>/dev/null); do killtree "$c"; done
  kill -TERM "$1" 2>/dev/null || true
}
cleanup() { rm -rf "$WORK" "$LOCK"; }
on_interrupt() {
  trap - INT TERM
  echo "" | tee -a "$LOG"
  echo "INTERRUPTED — stopping all workers (finished batches are kept; re-run to continue)" | tee -a "$LOG"
  for p in $(jobs -p); do killtree "$p"; done
  merge_leaves || true
  cleanup
  exit 130
}
trap on_interrupt INT TERM
trap cleanup EXIT

RUN_ID="$(date '+%Y-%m-%d %H:%M:%S')"
echo "========================================" | tee -a "$LOG"
echo "Book PDF Processor — $(date)" | tee -a "$LOG"
echo "PDF:    $PDF" | tee -a "$LOG"
echo "Output: $NOTES" | tee -a "$LOG"
echo "Pages:  $START → $END_PAGE of $TOTAL_PAGES (batch: $BATCH, parallel: $PARALLEL, sleep: ${SLEEP}s)" | tee -a "$LOG"
echo "Type:   $BOOK_TYPE ($TYPE_SOURCE)" | tee -a "$LOG"
echo "========================================" | tee -a "$LOG"
echo "# run $RUN_ID" >> "$MODEL_LOG"

# === PAGE IMAGE RENDERING (technical, practical, textbook) ===
# Every page as a 2x PNG in charts/ (kept for the HTML stage). Only pages that
# don't have an image yet are rendered.
if [ "$VISUAL" = true ]; then
  CHARTS_DIR="$DIR/charts"
  mkdir -p "$CHARTS_DIR"
  python3 - "$PDF" "$CHARTS_DIR" "$START" "$END_PAGE" <<'EXTRACT_EOF' | tee -a "$LOG"
import os, sys
try:
    import pymupdf as fitz
except ImportError:
    import fitz
pdf_path, charts_dir, start, end = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
doc = fitz.open(pdf_path)
made = 0
for n in range(start, min(end, len(doc)) + 1):
    fpath = os.path.join(charts_dir, f'page_{n:03d}.png')
    if not os.path.exists(fpath):
        doc[n - 1].get_pixmap(matrix=fitz.Matrix(2, 2)).save(fpath)
        made += 1
print(f'Images: {made} page images rendered ({start}-{end}; existing ones kept)')
EXTRACT_EOF
fi

MAX_ATTEMPTS=2   # Sonnet tries per batch before it is split
MIN_SPLIT=4      # ranges this small are not split further (Haiku gets them)
OVERLAP=2        # pages re-read from the previous batch for continuity
# Visual book types need more time and turns to read page images
case "$BOOK_TYPE" in
  technical)   TIMEOUT=1200 ; MAX_TURNS=15 ;;
  practical)   TIMEOUT=900  ; MAX_TURNS=12 ;;
  textbook)    TIMEOUT=900  ; MAX_TURNS=12 ;;
  *)           TIMEOUT=600  ; MAX_TURNS=8  ;;
esac

# Run a command with a timeout (macOS has no `timeout`); kills the whole
# process tree when time runs out.
run_with_timeout() {
  local SECS="$1"
  shift
  "$@" &
  local CMD_PID=$!
  ( sleep "$SECS"; if kill -0 "$CMD_PID" 2>/dev/null; then echo "  TIMEOUT after ${SECS}s" >&2; killtree "$CMD_PID"; fi ) &
  local TIMER_PID=$!
  local RC=0
  wait "$CMD_PID" 2>/dev/null || RC=$?
  killtree "$TIMER_PID"
  wait "$TIMER_PID" 2>/dev/null || true
  return $RC
}

# Worker log (each batch writes its own; appended to process.log in page order)
WLOG="/dev/null"
wlog() { echo "$*" >> "$WLOG"; }

# Function: build the prompt for a page range
# make_prompt READ_START REAL_START END [CONTEXT] [REJECTION]
#   READ_START..REAL_START-1 are overlap pages: read for context only.
#   REAL_START..END is the range to extract, mark, and acknowledge.
make_prompt() {
  local P_START="$1" R_START="$2" P_END="$3" CONTEXT="${4:-}" REJECTION="${5:-}"

  # Type-specific line targets and content rules
  local LINE_TARGET TYPE_INSTRUCTIONS
  case "$BOOK_TYPE" in
    analytical)
      LINE_TARGET="No fixed line target — length is determined by information density. Dense sections need more lines; repetitive sections need fewer."
      TYPE_INSTRUCTIONS="Content guidelines — optimize for COMPLETE USEFUL INFORMATION RECALL:
- Capture every distinct idea that could change what the reader understands, believes, argues, decides, or does
- For each concept, preserve: the claim, the reasoning/mechanism, the evidence, caveats/exceptions, and practical implications
- Keep MULTIPLE supporting examples when they teach DIFFERENT things (different application, limitation, mechanism, context). Only merge examples that make essentially the same point.
- Include contrarian/surprising claims with their supporting evidence
- Include things a reader would remember 5 years from now
- Include named individuals, books, or thinkers referenced
- MANDATORY: Tag each major idea with importance: [MUST KNOW], [SHOULD KNOW], or [NICE TO KNOW]
  Every batch MUST contain at least one tagged idea. If no tags are present, the batch fails quality.
- Flag obvious repetition: if the author restates a concept, note \"repeats X from earlier\" instead of re-capturing it
- Flag weak sections: if a chapter is mostly padding/anecdotes around one core idea, say so
- Skip TRUE filler only: repetitive restatements of the exact same point, excessive context-setting, obvious transitions, motivational fluff
- Do NOT skip: distinct examples, caveats, exceptions, boundary conditions, counterarguments, mechanisms, or secondary ideas that add genuine understanding"
      ;;
    narrative)
      LINE_TARGET="No fixed line target — length is determined by information density. Dense sections need more lines; repetitive sections need fewer."
      TYPE_INSTRUCTIONS="Content guidelines — optimize for COMPLETE USEFUL INFORMATION RECALL:
- Capture key historical episodes, turning points, and cause-effect chains
- Preserve timelines, dates, and sequences of events — these are the backbone
- Keep anecdotes and primary source quotes that bring events to life — include MULTIPLE anecdotes when they teach different things or reveal different aspects
- Include named individuals, their roles, and their decisions
- Note maps, charts, or visual references: [MAP: p.XX \"description\"] or [CHART: p.XX \"description\"]
- MANDATORY: Tag each major idea with importance: [MUST KNOW], [SHOULD KNOW], or [NICE TO KNOW]
  Every batch MUST contain at least one tagged idea. If no tags are present, the batch fails quality.
- Flag obvious repetition: note \"repeats X from earlier\" instead of re-capturing it
- Skip TRUE filler only: repetitive restatements of the exact same point, excessive context-setting, obvious transitions, motivational fluff
- Do NOT skip: distinct examples, caveats, mechanisms, causal explanations, counterarguments, or secondary ideas that add genuine understanding"
      ;;
    technical)
      LINE_TARGET="NO LINE TARGET — capture everything required to faithfully teach the material."
      TYPE_INSTRUCTIONS="Content guidelines — THIS IS A TECHNICAL/VISUAL BOOK.

NO LINE TARGET. Do not summarize instructional content. Do not compress chart explanations.
Compaction happens in a later step — your job is completeness.

CRITICAL RULE: These notes must teach the material as a STANDALONE LEARNING RESOURCE.
Do NOT assume the reader already understands the concept.
Do NOT assume the reader has read the original book.

If the notes jump straight to example numbers, chart conclusions, or trade outcomes
without first explaining the concept itself, they are INCOMPLETE.

TEACH FOR UNDERSTANDING, NOT JUST COVERAGE.

For every [MUST KNOW] technical concept, capture enough explanation that a beginner
who has not read the original book can understand and apply the concept:

1. WHAT IS IT?
   Define the concept clearly and precisely.

2. HOW IS IT STRUCTURED?
   If it is a setup, pattern, spread, indicator, or method,
   explain its components or construction.

3. WHAT DO I LOOK FOR?
   State the observable recognition criteria.
   Be concrete: price structure, sequence of highs/lows, indicator
   behavior, thresholds, relative movement, volume behavior, etc.

4. WHY DOES IT MATTER?
   Preserve the author's reasoning or market intuition.
   Do NOT jump directly from observation to conclusion.
   Explain the mechanism or logic connecting what you see to what it means.

5. WHEN DO I USE IT?
   Explain the situation, purpose, or decision context.
   When would someone choose this over alternatives?

6. HOW IS IT APPLIED?
   Preserve the trading/investment implication, entry/exit rule,
   confirmation rule, or analytical conclusion.

7. WHAT CONFIRMS OR LIMITS IT?
   Distinguish an early warning from a confirmed signal.
   What would invalidate or make the interpretation premature?

8. WHEN DOES IT FAIL?
   Preserve risks, false signals, regime dependencies,
   exceptions, and situations where the concept should not be trusted.

9. SHOW ONE CLEAR EXAMPLE.
   Preserve at least one strong worked example for every major concept.
   Walk through the evidence in the order a reader should inspect it.

[MUST KNOW] concepts get the full 9-point treatment.
[SHOULD KNOW] can be somewhat more compact but still must define and explain.
[NICE TO KNOW] can remain concise.

Do NOT compress explanation into shorthand that only makes sense to an
already-knowledgeable reader. Do NOT confuse recognizing the author's
finished example with understanding the concept from first principles.

HARD RULE: Never compress evidence → reasoning → conclusion into just conclusion.
Very important: do not write only conclusions like:
  \"Housing stocks broke their trendline, warning of a reversal.\"
Instead preserve the reasoning needed to reproduce that conclusion:
  where the trendline is drawn → what price behavior breaks it →
  what changes afterward → why that matters → what confirms the reversal.

Do not confuse KNOWING THE ANSWER with TEACHING THE METHOD.
If the notes only tell the reader what a chart proves, they are incomplete.
Preserve how the reader could discover the signal themselves.

CHART HANDLING:

A chart is NOT self-explanatory. A chart provides evidence.
The explanation teaches what the chart means.

If a page contains a chart, diagram, figure, table, or illustration, you MUST:
1. Use the Read tool to OPEN and VIEW the full-page image 'page_NNN.png' in your working directory
   (NNN = 3-digit zero-padded page number, e.g. page_087.png for page 87)
2. Tag it with [PAGE IMAGE: page_NNN.png]
3. After VIEWING the image, describe what you ACTUALLY SEE — axes, labels, data series,
   arrows, annotations, patterns, figure numbers, captions
4. Explain what the author is trying to teach with it
5. Walk through the recognition → reasoning → conclusion chain

HALLUCINATION GUARD:
- NEVER describe a chart you have not opened with the Read tool
- If you cannot access the image file, write: [IMAGE NOT AVAILABLE: page_NNN.png]
- Do NOT infer, invent, or guess labels, numbers, arrows, or annotations
- If the page is purely text with no visual content, do NOT tag it as a page image
Never omit a chart explanation. Never summarize a chart as \"see figure X.\"

Capture the full teaching sequence:
  concept → structure → recognition → chart evidence →
  reasoning/why → application/rule → confirmation/invalidation → failure mode
Do NOT summarize a 5-step pattern explanation into 1 bullet. Preserve each step.
Include every trading rule, entry/exit criteria, and risk management note verbatim.

DO NOT REMOVE:
- Price charts, candlestick diagrams, any market chart
- Support/resistance illustrations, trendline examples
- Chart pattern examples (head & shoulders, cup & handle, flags, etc.)
- Annotated screenshots or trading platform examples
- Indicator illustrations (RSI, MACD, volume, etc.)
- Trade setup examples with entry/exit points
- Any figure, diagram, or visual the author uses to teach a concept
- Step-by-step trading rules or checklists

PAGE IMAGES: Full-page renders are in your working directory as page_NNN.png.
Example:
  [PAGE IMAGE: page_087.png]
  This page shows Figure 4.1d — Dow 20 Bonds demonstrating downtrend to sideways
  to uptrend transition. The author marks three phases with arrows: the primary
  downtrend (lower highs, lower lows), the sideways accumulation base, and the
  breakout into a new uptrend. Key annotation: \"Buy signal confirmed when price
  breaks above the accumulation range on increased volume.\"

- Tag each major idea with importance: [MUST KNOW], [SHOULD KNOW], or [NICE TO KNOW]
- Only skip: duplicated charts showing the same thing, publisher filler, advertisements"
      ;;
    textbook)
      LINE_TARGET="NO LINE TARGET — capture everything required to faithfully teach the material."
      TYPE_INSTRUCTIONS="Content guidelines — THIS IS A TEXTBOOK. Preserve formulas and worked examples.

NO LINE TARGET. Do not summarize instructional content. Do not compress worked examples.
Compaction happens in a later step — your job is completeness.

CRITICAL RULE: A diagram is NOT supplementary material. A diagram IS the instructional content.

If a page contains a diagram, figure, table, or illustration, you MUST:
1. Use the Read tool to OPEN and VIEW the full-page image 'page_NNN.png' in your working directory
   (NNN = 3-digit zero-padded page number, e.g. page_087.png for page 87)
2. Tag it with [PAGE IMAGE: page_NNN.png]
3. After VIEWING the image, describe what you ACTUALLY SEE — axes, labels, formulas,
   annotations, figure numbers, captions
4. Explain what concept it teaches

HALLUCINATION GUARD:
- NEVER describe a diagram you have not opened with the Read tool
- If you cannot access the image file, write: [IMAGE NOT AVAILABLE: page_NNN.png]
- Do NOT infer, invent, or guess labels, numbers, or annotations
- If the page is purely text with no visual content, do NOT tag it as a page image
Never omit a diagram explanation.

- For every formula: write it out, explain what each variable means, give a worked example
- For proofs: skip the proof, but explain what the result MEANS and when it applies
- Preserve step-by-step derivations only when the steps teach something (not algebraic busywork)
- Include all definitions, theorems, and key results with their names
- For each concept: \"What does this let you DO?\" and \"When does this break down?\"
- Tag each major idea with importance: [MUST KNOW], [SHOULD KNOW], or [NICE TO KNOW]
- Skip: exercises (unless they illustrate a concept not covered elsewhere), repetitive drill problems
- Skip filler: excessive motivation, historical tangents that don't aid understanding"
      ;;
    practical)
      LINE_TARGET="NO LINE TARGET — capture everything required to faithfully teach the material."
      TYPE_INSTRUCTIONS="Content guidelines — THIS IS A PRACTICAL/STRATEGY BOOK. Preserve actionable detail.

NO LINE TARGET. Do not summarize strategies. Do not compress worked examples.
Compaction happens in a later step — your job is completeness.

CRITICAL RULE: A diagram is NOT supplementary material. A diagram IS the instructional content.

If a page contains a chart, diagram, payoff graph, table, or illustration, you MUST:
1. Use the Read tool to OPEN and VIEW the full-page image 'page_NNN.png' in your working directory
   (NNN = 3-digit zero-padded page number, e.g. page_087.png for page 87)
2. Tag it with [PAGE IMAGE: page_NNN.png]
3. After VIEWING the image, describe what you ACTUALLY SEE — axes, labels, strike prices,
   breakeven points, payoff curves, annotations, figure numbers, captions
4. Explain what strategy or concept it teaches

HALLUCINATION GUARD:
- NEVER describe a chart you have not opened with the Read tool
- If you cannot access the image file, write: [IMAGE NOT AVAILABLE: page_NNN.png]
- Do NOT infer, invent, or guess labels, numbers, or annotations
- If the page is purely text with no visual content, do NOT tag it as a page image
Never omit a diagram explanation.

DO NOT REMOVE:
- Payoff diagrams, P&L charts, risk/reward illustrations
- Strategy diagrams (spreads, straddles, iron condors, etc.)
- Greeks sensitivity charts or tables
- Step-by-step strategy construction with specific examples
- Entry/exit criteria, adjustment rules, rolling techniques
- Risk management rules and position sizing guidance
- Any table comparing strategies, showing breakeven points, or listing criteria

Preserve the full strategy walkthrough: setup → entry → management → exit.
Include specific numbers from examples (strike prices, premiums, dates) — not just concepts.
- Tag each major idea with importance: [MUST KNOW], [SHOULD KNOW], or [NICE TO KNOW]
- Skip: motivational filler, repeated disclaimers, basic definitions covered in earlier chapters"
      ;;
  esac

  # For visual book types, list the page images that sit next to pages.txt
  local CHART_MANIFEST=""
  if [ "$VISUAL" = true ]; then
    CHART_MANIFEST="
PAGE IMAGES: every page $P_START-$P_END has a full-page render in your working directory
as page_NNN.png (NNN = 3-digit page number, e.g. page_087.png).

For EVERY page that contains a chart, diagram, figure, or illustration
(pages.txt marks them [FIGURE ...]):
1. Use the Read tool to VIEW the page image file
2. Describe what you ACTUALLY SEE after viewing it
3. Tag it: [PAGE IMAGE: page_NNN.png]

Do NOT describe any image you have not opened with Read.
If a page is purely text, do NOT reference its image.
"
  fi

  cat <<PROMPT_EOF
You are creating study notes from a book. This is a personal, educational book-analysis project.
The goal is DEBATE-READY coverage: someone reading only these notes should capture every distinct
useful idea — not just main claims, but reasoning, mechanisms, evidence, caveats, exceptions,
counterarguments, and examples that teach something different.

READ the file 'pages.txt' in your working directory with the Read tool. It holds the text of
pages $P_START-$P_END of the book; each page starts with a line "=== PAGE N ===". Read all of it
(if the file is longer than one Read returns, continue with offset). Pages marked [FIGURE ...] or
[little or no text layer ...] have a page image (page_NNN.png) in the same folder: open it with
the Read tool whenever the page's meaning depends on it.

WRITE the notes to 'notes.md' in your working directory using the Write tool. $LINE_TARGET Markdown format:
- Chapter headers: ## Chapter N: Title
- Subheadings: ### Topic Name
- Key points as bullet points (-)
- Notable quotes as > blockquotes with attribution
- **Bold** for key terms, concepts, and names
$CHART_MANIFEST
$TYPE_INSTRUCTIONS
- Include named individuals, books, or thinkers referenced
- MANDATORY: Tag important ideas with [MUST KNOW], [SHOULD KNOW], or [NICE TO KNOW]
- MANDATORY: Assign each tagged nugget a unique sequential ID: [MUST KNOW][N001], [SHOULD KNOW][N002], etc.
  Number sequentially within THIS batch starting at [N001] — IDs are renumbered globally in page
  order after all batches merge. IDs enable the coverage audit to track every nugget from
  extraction through to the finished HTML. Example:
    - [MUST KNOW][N042] Survivorship bias: Wald showed military was reinforcing where returning planes
      had damage — but the damage on returning planes showed where planes could survive hits...
- Quotes in > blockquotes MUST be verbatim from the page text (they are checked against the PDF);
  if you can't quote exactly, paraphrase as a bullet instead of a blockquote
- Do NOT output preamble — ONLY write the notes
$(if [ -n "$CONTEXT" ]; then
cat <<CONTEXT_EOF

CONTINUITY CONTEXT — the previous batch ended with these notes (for context only):
---
$CONTEXT
---
Use this ONLY for continuity. Do NOT rewrite or repeat this material.
If the previous batch ended mid-concept, continue seamlessly.
CONTEXT_EOF
fi)

PAGE ACKNOWLEDGMENT (MANDATORY):
For EVERY page in the range $R_START-$P_END, include a marker:
  <!-- page NNN: X nuggets --> (if the page has substantive content)
  <!-- page NNN: no content --> (if the page is blank, index, copyright, etc.)
These markers are used to verify that every individual page was actually examined.
A batch without page acknowledgments for every page in the range will be rejected.

IMPORTANT: Extract notes for pages $R_START-$P_END ONLY. Page acknowledgments and nuggets must cover exactly this range.
$(if [ "$P_START" -lt "$R_START" ]; then
echo "Pages $P_START-$((R_START - 1)) are OVERLAP from the previous batch: read them for context continuity only —"
echo "do NOT re-extract, re-tag, quote, or acknowledge them."
fi)
$(if [ -n "$REJECTION" ]; then
echo ""
echo "A previous attempt at these pages was REJECTED because: $REJECTION"
echo "Make sure this attempt fixes that."
fi)
This is academic study material — process the content faithfully.
PROMPT_EOF
}

add_cost() { echo "${1:-0}" >> "$WORK/costs"; }

# try_leaf MODEL READ_START START END [CONTEXT] [REJECTION]
# One claude call for pages START-END. On success the notes are published as
# $DIR/.leaf_<start>_<end>.md (merged into notes.md after the wave).
# Sets LAST_REASON / LAST_STATUS for the caller.
LAST_REASON=""
LAST_STATUS=""
try_leaf() {
  local MODEL="$1" RS="$2" S="$3" E="$4" CTX="${5:-}" PREV="${6:-}"
  local BW="$WORK/b_${S}_${E}_${MODEL}_$RANDOM"
  mkdir -p "$BW"
  local IMG_ARGS=()
  [ "$VISUAL" = true ] && IMG_ARGS=(--charts "$DIR/charts" --all-images)
  if ! python3 "$LIB" pages "$PDF" "$RS" "$S" "$E" "$BW" ${IMG_ARGS[@]+"${IMG_ARGS[@]}"} 2>>"$BW/stderr.txt"; then
    LAST_REASON="could not read pages $RS-$E from the PDF"; LAST_STATUS=error
    wlog "  FAILED — pp. $S-$E: $LAST_REASON"
    return 1
  fi
  local PROMPT
  PROMPT=$(make_prompt "$RS" "$S" "$E" "$CTX" "$PREV")
  local TRY=0 STATUS="" COST=0 TURNS=0 MSG=""
  while :; do
    rm -f "$BW/notes.md"
    ( cd "$BW" && run_with_timeout "$TIMEOUT" "$CLAUDE" -p "$PROMPT" \
        --model "$MODEL" --max-turns "$MAX_TURNS" \
        --tools Read,Write --allowedTools Read Write \
        --strict-mcp-config --no-session-persistence --output-format json \
        > "$BW/result.json" 2>> "$BW/stderr.txt" ) || true
    { read -r STATUS; read -r COST; read -r TURNS; read -r MSG; } < <(python3 "$LIB" result "$BW/result.json") || true
    STATUS="${STATUS:-error}"
    if [ "$STATUS" = error ] && grep -qiE "usage limit|limit reached" "$BW/stderr.txt" 2>/dev/null; then STATUS=usage_limit; fi
    if [ "$STATUS" = error ] && grep -qiE "rate.?limit|overloaded|429|529" "$BW/stderr.txt" 2>/dev/null; then STATUS=rate_limit; fi
    add_cost "$COST"
    if [ "$STATUS" = rate_limit ] && [ "$TRY" -lt 3 ]; then
      TRY=$((TRY + 1))
      local WAIT=$(( BACKOFF * (2 ** (TRY - 1)) ))
      wlog "  RATE LIMIT — pp. $S-$E ($MODEL): waiting ${WAIT}s"
      sleep "$WAIT"
      continue
    fi
    break
  done
  LAST_STATUS="$STATUS"
  if [ "$STATUS" = usage_limit ]; then
    echo "$MSG" > "$WORK/fatal"
    LAST_REASON="usage limit reached: $MSG"
    wlog "  STOPPED — pp. $S-$E ($MODEL): $LAST_REASON"
    return 1
  fi
  if [ "$STATUS" = content_filter ]; then
    LAST_REASON="content filter: $MSG"
    wlog "  CONTENT_FILTER — pp. $S-$E ($MODEL)"
    return 1
  fi

  local G
  G=$(python3 "$LIB" gate "$BW/notes.md" "$S" "$E" "$BW/pages.json" "$BOOK_TYPE") || G="FAIL quality gate crashed"
  if [ "${G%% *}" != OK ]; then
    LAST_REASON="${G#FAIL }"
    [ "$STATUS" = max_turns ] && LAST_REASON="$LAST_REASON (ran out of turns)"
    [ "$STATUS" = error ] && LAST_REASON="$LAST_REASON (claude: $MSG)"
    wlog "  REJECTED — pp. $S-$E ($MODEL): $LAST_REASON"
    return 1
  fi

  # Fabrication check: "> quotes" must be in the PDF text of the pages read
  if [ -f "$BOOKS_DIR/verify_quotes.py" ]; then
    local QOUT="" QRC=0
    QOUT=$(python3 "$BOOKS_DIR/verify_quotes.py" --pdf "$PDF" --notes "$BW/notes.md" \
             --start "$RS" --end "$E" --json "$BW/quotes.json" --fail-ratio 0.5 2>&1) || QRC=$?
    if [ "$QRC" -eq 1 ]; then
      LAST_REASON="most > quotes are not in the page text (quote exact wording only, or paraphrase as a bullet)"
      wlog "  REJECTED — pp. $S-$E ($MODEL): $LAST_REASON"
      echo "$QOUT" | grep -E 'UNVERIFIED|PARAPHRASED|closest' | head -6 | while IFS= read -r l; do wlog "    $l"; done
      return 1
    elif echo "$QOUT" | grep -q 'UNVERIFIED'; then
      wlog "  QUOTE_WARNING — pp. $S-$E: $(echo "$QOUT" | grep -c 'UNVERIFIED') quote(s) not found in the PDF"
      echo "$QOUT" | grep -E 'UNVERIFIED|closest' | head -6 | while IFS= read -r l; do wlog "    $l"; done
    fi
  fi

  # Accept: canonical page marker first (the model's own markers are dropped),
  # then publish atomically so a crash never leaves half a batch.
  local LEAF
  LEAF="$DIR/$(printf '.leaf_%05d_%05d.md' "$S" "$E")"
  { echo "<!-- pp. $S-$E -->"; grep -vE '^[[:space:]]*<!--[[:space:]]*pp?\.[[:space:]]*[0-9]' "$BW/notes.md" || true; } > "$BW/leaf.md"
  mv "$BW/leaf.md" "$LEAF"
  echo "$S-$E:$MODEL" >> "$MODEL_LOG"
  [ "$MODEL" = haiku ] && echo "$S-$E" >> "$WORK/haiku"
  wlog "  OK — pp. $S-$E ($MODEL, +$(wc -l < "$LEAF" | tr -d ' ') lines, $(wc -w < "$LEAF" | tr -d ' ') words, $(grep -cE '\[(MUST KNOW|SHOULD KNOW|NICE TO KNOW)\]' "$LEAF" || true) tags, \$$COST)"
  rm -rf "$BW"
  return 0
}

# process_range READ_START START END [CONTEXT] [ATTEMPTS]
# Sonnet (with the rejection reason on the retry) → split in half → Haiku for
# ranges of MIN_SPLIT pages or fewer. Returns 1 if any page is still missing.
process_range() {
  local RS="$1" S="$2" E="$3" CTX="${4:-}" ATTEMPTS="${5:-$MAX_ATTEMPTS}"
  local N=$((E - S + 1)) REASON="" A=0
  while [ "$A" -lt "$ATTEMPTS" ]; do
    A=$((A + 1))
    [ -f "$WORK/fatal" ] && return 1
    if try_leaf sonnet "$RS" "$S" "$E" "$CTX" "$REASON"; then return 0; fi
    REASON="$LAST_REASON"
    [ "$LAST_STATUS" = content_filter ] && break
    [ "$A" -lt "$ATTEMPTS" ] && sleep 5
  done
  [ -f "$WORK/fatal" ] && return 1
  if [ "$N" -gt "$MIN_SPLIT" ]; then
    local M=$(( S + N / 2 - 1 )) RC=0
    wlog "  SPLIT — pp. $S-$E → $S-$M and $((M + 1))-$E"
    process_range "$RS" "$S" "$M" "$CTX" 1 || RC=1
    local RS2=$(( M + 1 - OVERLAP ))
    [ "$RS2" -lt 1 ] && RS2=1
    process_range "$RS2" $((M + 1)) "$E" "" 1 || RC=1
    return $RC
  fi
  wlog "  FALLBACK — pp. $S-$E: trying haiku (these pages will be flagged)"
  if try_leaf haiku "$RS" "$S" "$E" "$CTX" "$REASON"; then return 0; fi
  wlog "  FAILED — pp. $S-$E: $LAST_REASON"
  echo "$S-$E" >> "$WORK/failed"
  return 1
}

# Move finished batches (.leaf_*.md) into notes.md in page order and record
# the pages they acknowledge. Also picks up batches a crashed run finished.
LAST_TAIL=""
LAST_END=-1
MERGED=0
merge_leaves() {
  local F BASE S E ACKS UNACKED
  while IFS= read -r F; do
    [ -f "$F" ] || continue
    BASE="$(basename "$F" .md)"          # .leaf_00021_00040
    S=$((10#$(echo "$BASE" | cut -d_ -f2)))
    E=$((10#$(echo "$BASE" | cut -d_ -f3)))
    cat "$F" >> "$NOTES"
    echo "" >> "$NOTES"
    ACKS=$(python3 "$LIB" acks "$F" "$S" "$E" || true)
    for p in $ACKS; do echo "$p" >> "$PAGES_DONE"; done
    UNACKED=$(( E - S + 1 - $(echo "$ACKS" | wc -w | tr -d ' ') ))
    if [ "$UNACKED" -gt 0 ]; then
      echo "  Merged: pp. $S-$E ($(wc -l < "$F" | tr -d ' ') lines, $UNACKED page(s) unacknowledged — will retry)" | tee -a "$LOG"
    else
      echo "  Merged: pp. $S-$E ($(wc -l < "$F" | tr -d ' ') lines, all pages acknowledged)" | tee -a "$LOG"
    fi
    LAST_TAIL=$(tail -50 "$F")
    LAST_END=$E
    MERGED=$((MERGED + 1))
    rm -f "$F"
  done < <(ls "$DIR"/.leaf_*.md 2>/dev/null | sort)
  sort -un "$PAGES_DONE" -o "$PAGES_DONE"
}

# Run a list of batches ("READ_START START END" lines) in parallel waves.
run_batches() {
  local LABEL="$1" PAR="$2"
  shift 2
  local SPECS=("$@")
  local TOTAL=${#SPECS[@]} IDX=0 WAVE=0
  while [ "$IDX" -lt "$TOTAL" ]; do
    [ -f "$WORK/fatal" ] && break
    WAVE=$((WAVE + 1))
    local WAVE_END=$((IDX + PAR))
    [ "$WAVE_END" -gt "$TOTAL" ] && WAVE_END=$TOTAL
    echo "" | tee -a "$LOG"
    echo "--- $LABEL wave $WAVE: batches $((IDX + 1))-$WAVE_END of $TOTAL ($(date '+%H:%M:%S')) ---" | tee -a "$LOG"
    local W PIDS=() LOGS=()
    for ((W = IDX; W < WAVE_END; W++)); do
      local RS S E CTX=""
      read -r RS S E <<< "${SPECS[$W]}"
      if [ "$RS" != "$S" ]; then
        echo "  Starting: pp. $S-$E (reading from $RS for overlap)" | tee -a "$LOG"
      else
        echo "  Starting: pp. $S-$E" | tee -a "$LOG"
      fi
      # Continuity context only when the batch right before this one has
      # already been merged (first batch of a wave, or PARALLEL=1)
      if [ -n "$LAST_TAIL" ] && [ "$LAST_END" -eq $((S - 1)) ]; then CTX="$LAST_TAIL"; fi
      local L="$WORK/log_$(printf '%05d' "$S").txt"
      LOGS+=("$L")
      ( WLOG="$L"; process_range "$RS" "$S" "$E" "$CTX" ) &
      PIDS+=($!)
    done
    for P in "${PIDS[@]}"; do wait "$P" || true; done
    for L in "${LOGS[@]}"; do [ -f "$L" ] && cat "$L" >> "$LOG" && rm -f "$L"; done
    merge_leaves
    IDX=$WAVE_END
    if [ "$IDX" -lt "$TOTAL" ]; then sleep "$SLEEP"; fi
  done
}

plan() {  # plan START END BATCH → batch specs for pages not done yet
  python3 "$LIB" plan "$PAGES_DONE" "$1" "$2" "$3" "$OVERLAP"
}

# ── Extraction ────────────────────────────────────────────────────────────
merge_leaves   # finished batches left behind by an interrupted run

SPECS=()
while IFS= read -r line; do SPECS+=("$line"); done < <(plan "$START" "$END_PAGE" "$BATCH")
DONE_BEFORE=$(( END_PAGE - START + 1 - $(python3 "$LIB" missing "$PAGES_DONE" "$START" "$END_PAGE" | tr ' ' '\n' | awk -F- 'NF==2{n+=$2-$1+1} NF==1&&$1!=""{n++} END{print n+0}') ))
if [ ${#SPECS[@]} -eq 0 ]; then
  echo "All pages $START-$END_PAGE are already extracted — nothing to do." | tee -a "$LOG"
else
  [ "$DONE_BEFORE" -gt 0 ] && echo "Resuming: $DONE_BEFORE page(s) already done are skipped." | tee -a "$LOG"
  echo "Batches: ${#SPECS[@]} (processing $PARALLEL at a time)" | tee -a "$LOG"
  run_batches "Main" "$PARALLEL" "${SPECS[@]}"

  # === GAP-FILL — whatever is still missing, as small batches with overlap ===
  if [ ! -f "$WORK/fatal" ]; then
    GAPS=()
    while IFS= read -r line; do GAPS+=("$line"); done < <(plan "$START" "$END_PAGE" "$MIN_SPLIT")
    if [ ${#GAPS[@]} -gt 0 ]; then
      echo "" | tee -a "$LOG"
      echo "=== GAP-FILL — $(python3 "$LIB" missing "$PAGES_DONE" "$START" "$END_PAGE") ===" | tee -a "$LOG"
      run_batches "Gap-fill" 1 "${GAPS[@]}"
    fi
  fi
fi

COST=$(awk '{s+=$1} END {printf "%.2f", s+0}' "$WORK/costs" 2>/dev/null || echo 0.00)
MISSING=$(python3 "$LIB" missing "$PAGES_DONE" 1 "$TOTAL_PAGES")
HAIKU_RUN=$(sort -n "$WORK/haiku" 2>/dev/null | tr '\n' ' ' | sed 's/ $//' || true)
