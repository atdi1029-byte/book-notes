# === DUPLICATE REPORT (nothing is deleted) ===
# Sections that cover the same pages twice are listed in
# notes.duplicates-report.md for review. (The old pass deleted the shorter
# copy and lost unique content that way.)
echo "" | tee -a "$LOG"
echo "=== DUPLICATES — report only ===" | tee -a "$LOG"
python3 - "$NOTES" <<'DEDUP_EOF' 2>>"$LOG" | tee -a "$LOG" || true
import re, sys
from collections import defaultdict
path = sys.argv[1]
text = open(path, encoding='utf-8', errors='replace').read()
blocks = re.split(r'(?m)^(?=<!--\s*pp?\.\s*\d)', text)
seen = defaultdict(list)
for i, b in enumerate(blocks):
    m = re.match(r'<!--\s*pp?\.\s*(\d+)(?:\s*-\s*(\d+))?\s*-->', b)
    if not m:
        continue
    s = int(m.group(1)); e = int(m.group(2) or s)
    for p in range(s, e + 1):
        seen[p].append(i)
dupes = sorted(p for p, v in seen.items() if len(v) > 1)
report = path.replace('notes.md', 'notes.duplicates-report.md')
if not dupes:
    print('  No page is covered twice — clean.')
    try:
        import os; os.remove(report)
    except OSError:
        pass
else:
    runs = []
    for p in dupes:
        if runs and p == runs[-1][1] + 1: runs[-1][1] = p
        else: runs.append([p, p])
    desc = ', '.join(str(a) if a == b else f'{a}-{b}' for a, b in runs)
    with open(report, 'w', encoding='utf-8') as f:
        f.write('# Pages covered more than once in notes.md\n\n')
        f.write('Nothing was removed. Merge or delete the extra copies by hand if they repeat each other.\n\n')
        f.write(f'Pages: {desc}\n')
    print(f'  {len(dupes)} page(s) covered more than once ({desc}) — see notes.duplicates-report.md')
DEDUP_EOF

# === VERIFICATION PASS ===
echo "" | tee -a "$LOG"
echo "=== VERIFY — page coverage ===" | tee -a "$LOG"
python3 - "$NOTES" "$PAGES_DONE" "$START" "$END_PAGE" <<'VERIFY_EOF' 2>>"$LOG" | tee -a "$LOG" || true
import re, sys
notes_path, done_path, start_page, end_page = sys.argv[1], sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
content = open(notes_path, encoding='utf-8', errors='replace').read()
chapters = [h.strip() for h in re.findall(r'^## (.+)$', content, re.M)]
done = set()
for line in open(done_path):
    line = line.strip()
    if line.isdigit():
        done.add(int(line))
missing = [p for p in range(start_page, end_page + 1) if p not in done]
must = len(re.findall(r'\[MUST KNOW\]', content))
should = len(re.findall(r'\[SHOULD KNOW\]', content))
nice = len(re.findall(r'\[NICE TO KNOW\]', content))
ids = set(re.findall(r'\[N(\d+)\]', content))
print(f'  Sections (## headers): {len(chapters)}')
print(f'  Pages done: {len(done & set(range(start_page, end_page + 1)))} of {end_page - start_page + 1}')
if missing:
    print(f'  Missing pages: {len(missing)} (first 20: {missing[:20]})')
print(f'  Total notes: {content.count(chr(10))} lines')
print(f'  Nugget tags: {must} MUST, {should} SHOULD, {nice} NICE — {len(ids)} unique IDs')
issues = []
if missing:
    issues.append(f'{len(missing)} missing pages')
if must + should == 0:
    issues.append('no MUST/SHOULD KNOW tags')
print(f'  VERDICT: INCOMPLETE — {", ".join(issues)}' if issues else '  VERDICT: COMPLETE')
VERIFY_EOF

# === QUOTE AUDIT — whole notes.md against the PDF ===
echo "" | tee -a "$LOG"
echo "=== QUOTE AUDIT — notes.md vs PDF ===" | tee -a "$LOG"
