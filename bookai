import re, os
from collections import defaultdict

notes_path = os.environ['NOTES_FILE']
with open(notes_path, 'r') as f:
    lines = f.readlines()

# Parse sections by ## headers
sections = []
current_start = 0
for i in range(len(lines)):
    if lines[i].startswith('## ') and i > 0:
        sections.append((current_start, i))
        current_start = i
sections.append((current_start, len(lines)))

def get_section_key(header):
    m = re.match(r'## Chapter (\d+)', header)
    if m:
        return f"chapter_{m.group(1)}"
    if 'Appendix I:' in header or 'Appendix I ' in header:
        return 'appendix_i'
    if 'Appendix II' in header:
        return 'appendix_ii'
    m = re.match(r'## Book ([IVX]+)', header)
    if m:
        return f"book_{m.group(1)}"
    return None

def get_page_ranges(block):
    """Extract page numbers covered by a section from <!-- pp. X-Y --> markers."""
    pages = set()
    for m in re.finditer(r'<!-- pp?\. (\d+)(?:-(\d+))? -->', block):
        start = int(m.group(1))
        end = int(m.group(2)) if m.group(2) else start
        for p in range(start, end + 1):
            pages.add(p)
    return pages

# Group sections by key
groups = defaultdict(list)
for s, e in sections:
    h = lines[s].strip()
    key = get_section_key(h)
    if key:
        block = ''.join(lines[s:e])
        pages = get_page_ranges(block)
        groups[key].append((s, e, h, e - s, pages))

# Find duplicates — page-aware merging
remove_ranges = set()
dedup_count = 0
for key, secs in groups.items():
    if len(secs) <= 1:
        continue
    # "continued" sections are intentional, skip them
    non_continued = [(s, e, h, sz, pg) for s, e, h, sz, pg in secs if '(cont' not in h.lower()]
    if len(non_continued) <= 1:
        continue

    # Check if duplicates cover different pages (overlap vs distinct)
    all_pages = set()
    has_unique_pages = False
    for s, e, h, sz, pg in non_continued:
        if pg and not pg.issubset(all_pages):
            if all_pages:  # second+ section has pages not in first
                has_unique_pages = True
            all_pages.update(pg)

    if has_unique_pages:
        # Different page ranges — keep all, just warn
        page_strs = []
        for s, e, h, sz, pg in non_continued:
            page_strs.append(f"[{s+1}-{e}] pages {sorted(pg)[:5]}...")
        print(f"  KEEP ALL {key} — sections cover different pages: {'; '.join(page_strs)}")
    else:
        # Same or no page markers — check if ALL sections lack markers (unsafe to dedup)
        sections_with_markers = sum(1 for s, e, h, sz, pg in non_continued if pg)
        if sections_with_markers == 0:
            # No page markers at all — refuse to dedup, keep both to avoid data loss
            print(f"  KEEP ALL {key} — no page markers on any section, refusing to dedup (safer)")
            continue

        # True duplicates (same page ranges) — keep the longest
        non_continued.sort(key=lambda x: x[3], reverse=True)
        keeper = non_continued[0]
        for s, e, h, sz, pg in non_continued[1:]:
            remove_ranges.add((s, e))
            dedup_count += 1
            print(f"  REMOVE duplicate: [{s+1}-{e}] ({sz} lines) {h[:60]}")
        print(f"  KEEP:             [{keeper[0]+1}-{keeper[1]}] ({keeper[3]} lines) {keeper[2][:60]}")

# Also remove template placeholders
for s, e in sections:
    h = lines[s].strip()
    block = ''.join(lines[s:e])
    if '[Title]' in h or ('[Quote]' in block and '## Notable Quotes' in h):
        remove_ranges.add((s, e))
        dedup_count += 1
        print(f"  REMOVE template:  [{s+1}-{e}] {h[:60]}")

if dedup_count == 0:
    print("  No duplicates found — clean!")
else:
    # Rebuild file without removed ranges
    output = []
    for s, e in sections:
        if (s, e) not in remove_ranges:
            output.extend(lines[s:e])

    with open(notes_path, 'w') as f:
        f.writelines(output)

    new_lines = len(output)
    print(f"  Removed {dedup_count} duplicate sections ({len(lines) - new_lines} lines)")
    print(f"  File: {len(lines)} → {new_lines} lines")
DEDUP_EOF

