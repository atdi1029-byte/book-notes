# Function: process a single batch with model fallback
# On content filter errors, immediately tries haiku instead of retrying sonnet.
process_batch() {
  local B_START="$1" B_END="$2" TEMP_FILE="$3" BATCH_LOG="$4"

  local MODELS=("sonnet" "haiku")

  for MODEL in "${MODELS[@]}"; do
    local RETRY=0
    while [ "$RETRY" -lt "$MAX_RETRIES" ]; do
      if [ "$RETRY" -gt 0 ]; then
        sleep 30
      fi

      local PROMPT
      PROMPT=$(make_prompt "$B_START" "$B_END" "$TEMP_FILE")
      local STDERR_FILE="$DIR/.stderr_${B_START}_${B_END}.tmp"

      run_with_timeout "$TIMEOUT" \
        claude -p "$PROMPT" \
        --model "$MODEL" \
        --max-turns "$MAX_TURNS" \
        --allowedTools "Read" "Write" \
        2>"$STDERR_FILE" || true

      local STDERR_CONTENT=""
      [ -f "$STDERR_FILE" ] && STDERR_CONTENT=$(cat "$STDERR_FILE") && rm -f "$STDERR_FILE"

      # Check if temp file was created with quality content
      if [ -f "$TEMP_FILE" ] && [ "$(wc -c < "$TEMP_FILE" | tr -d ' ')" -gt 50 ]; then
        local LINES=$(wc -l < "$TEMP_FILE" | tr -d ' ')
        local WORDS=$(wc -w < "$TEMP_FILE" | tr -d ' ')
        local HAS_MARKERS=$(grep -c '<!-- pp' "$TEMP_FILE" 2>/dev/null || true)
        local HAS_HEADERS=$(grep -c '^##' "$TEMP_FILE" 2>/dev/null || true)
        local HAS_BULLETS=$(grep -c '^- ' "$TEMP_FILE" 2>/dev/null || true)

        # Quality gate — thresholds vary by book type
        local MIN_WORDS MIN_LINES MIN_BULLETS
        case "$BOOK_TYPE" in
          technical|practical|textbook)
            MIN_WORDS=300 ; MIN_LINES=30 ; MIN_BULLETS=5 ;;
          *)
            MIN_WORDS=200 ; MIN_LINES=20 ; MIN_BULLETS=4 ;;
        esac

        # Check for priority tags with nugget IDs (e.g. [MUST KNOW][N042])
        local HAS_TAGS=$(grep -cE '\[(MUST KNOW|SHOULD KNOW|NICE TO KNOW)\]\[N[0-9]+\]' "$TEMP_FILE" 2>/dev/null || true)
        # Also accept tags without IDs (legacy format) but prefer with IDs
        local HAS_TAGS_ANY=$(grep -cE '\[(MUST KNOW|SHOULD KNOW|NICE TO KNOW)\]' "$TEMP_FILE" 2>/dev/null || true)

        if [ "$WORDS" -ge "$MIN_WORDS" ] && [ "$LINES" -ge "$MIN_LINES" ] && [ "$((HAS_MARKERS + HAS_HEADERS))" -ge 1 ] && [ "$HAS_BULLETS" -ge "$MIN_BULLETS" ]; then
          # MANDATORY: Priority tags must be present for coverage audit to work
          if [ "$HAS_TAGS_ANY" -eq 0 ]; then
            echo "  TAG_FAIL — pp. $B_START-$B_END ($MODEL): no [MUST KNOW]/[SHOULD KNOW]/[NICE TO KNOW] tags — retrying" >> "$BATCH_LOG"
            rm -f "$TEMP_FILE"
            RETRY=$((RETRY + 1))
            continue
          fi
          # Warn if tags lack nugget IDs (needed for coverage audit)
          if [ "$HAS_TAGS" -eq 0 ] && [ "$HAS_TAGS_ANY" -gt 0 ]; then
            echo "  ID_WARNING — pp. $B_START-$B_END: tags present but missing nugget IDs [N###]" >> "$BATCH_LOG"
          fi
          # Check per-page acknowledgments (<!-- page NNN: ... -->)
          local PAGE_ACKS=$(grep -cE '<!-- page [0-9]+:' "$TEMP_FILE" 2>/dev/null || true)
          local EXPECTED_PAGES=$(( B_END - B_START + 1 ))
          if [ "$PAGE_ACKS" -lt "$EXPECTED_PAGES" ]; then
            echo "  PAGE_ACK_WARNING — pp. $B_START-$B_END: $PAGE_ACKS/$EXPECTED_PAGES pages acknowledged" >> "$BATCH_LOG"
          fi
          # For visual books: check PAGE IMAGE references exist when page images are present
          if [[ "$BOOK_TYPE" == "technical" || "$BOOK_TYPE" == "practical" || "$BOOK_TYPE" == "textbook" ]]; then
            local PAGE_IMGS=$(ls "$DIR/charts"/page_*.png 2>/dev/null | sed 's/.*page_\([0-9]*\).*/\1/' | sort -un | awk -v s="$B_START" -v e="$B_END" '$1>=s && $1<=e' | wc -l | tr -d ' ')
            local IMG_REFS=$(grep -cE '\[PAGE IMAGE:|IMAGE NOT AVAILABLE:' "$TEMP_FILE" 2>/dev/null || true)
            if [ "$PAGE_IMGS" -gt 3 ] && [ "$IMG_REFS" -eq 0 ]; then
              echo "  QUALITY_FAIL — pp. $B_START-$B_END ($MODEL): $PAGE_IMGS page images but 0 references" >> "$BATCH_LOG"
              rm -f "$TEMP_FILE"
              RETRY=$((RETRY + 1))
              continue
            fi
          fi

          echo "  OK — pp. $B_START-$B_END ($MODEL, +$LINES lines, $WORDS words, $HAS_TAGS tags)" >> "$BATCH_LOG"
          echo "$B_START-$B_END:$MODEL" >> "$MODEL_LOG"
          return 0
        else
          echo "  QUALITY_FAIL — pp. $B_START-$B_END ($MODEL): ${WORDS}w, ${HAS_MARKERS}m, ${HAS_HEADERS}h, ${HAS_BULLETS}b" >> "$BATCH_LOG"
          rm -f "$TEMP_FILE"
          RETRY=$((RETRY + 1))
          continue
        fi
      fi

      # Content filter? Skip straight to next model
      if echo "$STDERR_CONTENT" | grep -qiE "content filter|content policy|unable to process"; then
        echo "  CONTENT_FILTER — pp. $B_START-$B_END ($MODEL)" >> "$BATCH_LOG"
        rm -f "$TEMP_FILE"
        break  # break retry loop, try next model
      fi

      # Other error — retry same model
      RETRY=$((RETRY + 1))
      echo "  RETRY $RETRY — pp. $B_START-$B_END ($MODEL)" >> "$BATCH_LOG"
      rm -f "$TEMP_FILE"
    done
  done

  echo "  FAILED — pp. $B_START-$B_END after all models" >> "$BATCH_LOG"
  return 1
}

# Build list of all batch ranges with 2-page overlap for boundary protection
# Each batch reads 2 extra pages from the previous batch's end to catch ideas
# that span batch boundaries. The prompt tells Claude not to re-extract content
# from the overlap pages — just use them for context continuity.
OVERLAP=2
BATCHES=()
PAGE=$START
while [ "$PAGE" -le "$END_PAGE" ]; do
  BATCH_END=$((PAGE + BATCH - 1))
  [ "$BATCH_END" -gt "$END_PAGE" ] && BATCH_END=$END_PAGE
  if [ "$PAGE" -gt "$START" ]; then
    # Include overlap pages from previous batch for context
    OVERLAP_START=$((PAGE - OVERLAP))
    [ "$OVERLAP_START" -lt "$START" ] && OVERLAP_START=$START
    BATCHES+=("${OVERLAP_START}o${PAGE}:$BATCH_END")  # format: overlapStart o realStart : end
  else
    BATCHES+=("$PAGE:$BATCH_END")
  fi
  PAGE=$((BATCH_END + 1))
done

TOTAL=${#BATCHES[@]}
echo "Batches: $TOTAL (processing $PARALLEL at a time)" | tee -a "$LOG"

# Process batches in parallel waves
IDX=0
FAILURES=0
WAVE_NUM=0
PREV_BATCH_CONTEXT=""  # last 50 lines of previous batch for continuity
export PREV_BATCH_CONTEXT

while [ "$IDX" -lt "$TOTAL" ]; do
  WAVE_NUM=$((WAVE_NUM + 1))
  WAVE_END=$((IDX + PARALLEL))
  [ "$WAVE_END" -gt "$TOTAL" ] && WAVE_END=$TOTAL

  echo "" | tee -a "$LOG"
  echo "--- Wave $WAVE_NUM: batches $((IDX+1))-$WAVE_END of $TOTAL ($(date '+%H:%M:%S')) ---" | tee -a "$LOG"

  # Launch parallel workers
  PIDS=()
  WAVE_RANGES=()  # track real ranges for merge step
  for ((W=IDX; W<WAVE_END; W++)); do
    BATCH_SPEC="${BATCHES[$W]}"

    # Parse batch spec: either "start:end" or "overlapStartoRealStart:end"
    if [[ "$BATCH_SPEC" == *"o"* ]]; then
      B_READ_START="${BATCH_SPEC%%o*}"
      REST="${BATCH_SPEC#*o}"
      B_REAL_START="${REST%%:*}"
      B_END="${REST#*:}"
    else
      IFS=: read -r B_REAL_START B_END <<< "$BATCH_SPEC"
      B_READ_START="$B_REAL_START"
    fi

    TEMP="$DIR/.batch_${B_REAL_START}_${B_END}.md"
    BATCH_LOG="$DIR/.batch_${B_REAL_START}_${B_END}.log"
    rm -f "$TEMP" "$BATCH_LOG"
    WAVE_RANGES+=("$B_READ_START:$B_REAL_START:$B_END")

    if [ "$B_READ_START" != "$B_REAL_START" ]; then
      echo "  Starting: pp. $B_REAL_START-$B_END (reading from $B_READ_START for overlap)" | tee -a "$LOG"
    else
      echo "  Starting: pp. $B_REAL_START-$B_END" | tee -a "$LOG"
    fi
    process_batch "$B_READ_START" "$B_END" "$TEMP" "$BATCH_LOG" &
    PIDS+=($!)
  done

  # Wait for all workers in this wave
  WAVE_RESULTS=()
  for PID in "${PIDS[@]}"; do
    if wait "$PID"; then
      WAVE_RESULTS+=(0)
    else
      WAVE_RESULTS+=(1)
    fi
  done

  # Merge completed temp files in page order and log results
  for ((W=IDX; W<WAVE_END; W++)); do
    local_idx=$((W - IDX))
    IFS=: read -r B_READ_START B_REAL_START B_END <<< "${WAVE_RANGES[$local_idx]}"
    TEMP="$DIR/.batch_${B_REAL_START}_${B_END}.md"
    BATCH_LOG="$DIR/.batch_${B_REAL_START}_${B_END}.log"

    # Append batch log to main log
    [ -f "$BATCH_LOG" ] && cat "$BATCH_LOG" >> "$LOG" && rm -f "$BATCH_LOG"

    if [ "${WAVE_RESULTS[$local_idx]}" -eq 0 ] && [ -f "$TEMP" ]; then
      LINES=$(wc -l < "$TEMP" | tr -d ' ')
      cat "$TEMP" >> "$NOTES"
      echo "" >> "$NOTES"
      # Parse actual page acknowledgments — only count real pages (not overlap)
      UNACKED=$(record_acknowledged_pages "$TEMP" "$B_REAL_START" "$B_END")
      # Capture last 50 lines for continuity context (used by next batch)
      PREV_BATCH_CONTEXT=$(tail -50 "$TEMP")
      export PREV_BATCH_CONTEXT
      if [ "$UNACKED" -gt 0 ]; then
        echo "  Merged: pp. $B_REAL_START-$B_END ($LINES lines, $UNACKED pages unacknowledged — will retry)" | tee -a "$LOG"
      else
        echo "  Merged: pp. $B_REAL_START-$B_END ($LINES lines, all pages acknowledged)" | tee -a "$LOG"
      fi
      rm -f "$TEMP"
    else
      FAILURES=$((FAILURES + 1))
      echo "  FAILED: pp. $B_REAL_START-$B_END" | tee -a "$LOG"
      rm -f "$TEMP"
    fi
  done

  IDX=$WAVE_END

  # Brief sleep between waves
  if [ "$IDX" -lt "$TOTAL" ]; then
    sleep "$SLEEP"
  fi
done

echo "" | tee -a "$LOG"
echo "========================================" | tee -a "$LOG"
echo "DONE — $(date)" | tee -a "$LOG"
echo "Batches: $TOTAL total, $FAILURES failed" | tee -a "$LOG"
echo "Notes:   $(wc -l < "$NOTES") lines" | tee -a "$LOG"

